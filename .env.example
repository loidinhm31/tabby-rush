# Glean Hub Configuration Template
# Copy this file to .env and configure with your environment-specific credentials.

# Approved Glean Hub Origin (e.g., https://hub.example.com or http://10.0.2.2:3000 for local Android dev)
APPROVED_HUB_ORIGIN=https://hub.example.com

# Provisioned TabbyRush Application API Key
TABBYRUSH_API_KEY=your_api_key_here
