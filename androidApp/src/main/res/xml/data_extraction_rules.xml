<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12 (API 31) and above.
  Explicitly excludes cloud backup and device-to-device transfer
  for local databases, credentials, account partitioning, and wipe markers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="accounts" />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="accounts" />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
