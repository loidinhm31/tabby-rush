import dev.tabbyrush.shared.contract.LeaveGuardState
import dev.tabbyrush.shared.contract.TodoAction
import dev.tabbyrush.shared.theme.TabbyRushThemeTokens

@Composable
fun LeaveGuard(
    leaveGuard: LeaveGuardState,
    onAction: (TodoAction) -> Unit,
    modifier: Modifier = Modifier
) {
    Card(
        modifier = modifier
            .fillMaxWidth()
            .padding(TabbyRushThemeTokens.SpacingLarge),
        colors = CardDefaults.cardColors(
            containerColor = MaterialTheme.colorScheme.surface
        ),
        shape = MaterialTheme.shapes.large,
        elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)
    ) {
        Column(
            modifier = Modifier
                .padding(TabbyRushThemeTokens.SpacingLarge)
                .fillMaxWidth()
                .verticalScroll(rememberScrollState())
        ) {
            Text(
                text = "Leave Account?",
                style = MaterialTheme.typography.titleLarge,
                color = MaterialTheme.colorScheme.error,
                modifier = Modifier.semantics { heading() }
            )

            Spacer(modifier = Modifier.height(TabbyRushThemeTokens.SpacingSmall))

            Text(
                text = "Leaving this account will remove local cached data and credentials from this device. Remote data on the Hub will remain intact. Any in-flight requests may still commit remotely.",
                style = MaterialTheme.typography.bodyMedium,
                color = MaterialTheme.colorScheme.onSurface
            )

            val hasUnsynced = leaveGuard.pendingCount > 0 ||
                    leaveGuard.uncertainCount > 0 ||
                    leaveGuard.conflictCount > 0

            if (hasUnsynced) {
                Spacer(modifier = Modifier.height(TabbyRushThemeTokens.SpacingMedium))

                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .background(
                            color = TabbyRushThemeTokens.customColors.coralSurface,
                            shape = MaterialTheme.shapes.small
                        )
                        .padding(TabbyRushThemeTokens.SpacingMedium)
                ) {
                    Text(
                        text = "Unsynchronized local changes will be lost from this device:",
                        style = MaterialTheme.typography.labelMedium,
                        color = MaterialTheme.colorScheme.error
                    )

                    Spacer(modifier = Modifier.height(TabbyRushThemeTokens.SpacingXSmall))

                    if (leaveGuard.pendingCount > 0) {
                        Text(
                            text = "• ${leaveGuard.pendingCount} pending local operations",
                            style = MaterialTheme.typography.bodySmall,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                    }

                    if (leaveGuard.uncertainCount > 0) {
                        Text(
                            text = "• ${leaveGuard.uncertainCount} uncertain operations awaiting server confirmation",
                            style = MaterialTheme.typography.bodySmall,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                    }

                    if (leaveGuard.conflictCount > 0) {
                        Text(
                            text = "• ${leaveGuard.conflictCount} unresolved conflicts",
                            style = MaterialTheme.typography.bodySmall,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                    }
                }
            }

            Spacer(modifier = Modifier.height(TabbyRushThemeTokens.SpacingLarge))
            HorizontalDivider(color = TabbyRushThemeTokens.customColors.line)
            Spacer(modifier = Modifier.height(TabbyRushThemeTokens.SpacingLarge))

            Column(
                modifier = Modifier.fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(TabbyRushThemeTokens.SpacingSmall)
            ) {
                OutlinedButton(
                    onClick = { onAction(TodoAction.CancelLeave) },
                    modifier = Modifier
                        .fillMaxWidth()
                        .defaultMinSize(minHeight = TabbyRushThemeTokens.MinTouchTargetSize),
                    shape = MaterialTheme.shapes.small
                ) {
                    Text(
                        text = "Cancel & Stay",
                        style = MaterialTheme.typography.labelLarge,
                        color = TabbyRushThemeTokens.customColors.primaryDeep
                    )
                }

                Button(
                    onClick = { onAction(TodoAction.ConfirmLeave) },
                    modifier = Modifier
                        .fillMaxWidth()
                        .defaultMinSize(minHeight = TabbyRushThemeTokens.MinTouchTargetSize),
                    colors = ButtonDefaults.buttonColors(
                        containerColor = MaterialTheme.colorScheme.error,
                        contentColor = MaterialTheme.colorScheme.onError
                    ),
                    shape = MaterialTheme.shapes.small
                ) {
                    Text(
                        text = "Leave & Wipe Local Data",
                        style = MaterialTheme.typography.labelLarge
                    )
                }
            }
        }
    }
}
