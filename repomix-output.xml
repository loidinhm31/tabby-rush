package dev.tabbyrush.android

import android.content.Context
import androidx.test.core.app.ApplicationProvider
import androidx.test.ext.junit.runners.AndroidJUnit4
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.AuthState
import dev.tabbyrush.shared.contract.TaskRef
import dev.tabbyrush.shared.contract.Todo
import dev.tabbyrush.shared.contract.TodoAction
import kotlinx.coroutines.runBlocking
import org.junit.After
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNotNull
import org.junit.Before
import org.junit.Test
import org.junit.runner.RunWith

@RunWith(AndroidJUnit4::class)
class TodoDeviceTest {

    private lateinit var context: Context
    private lateinit var app: TabbyRushApplication
    private val canonicalIdentity = dev.tabbyrush.shared.contract.AccountIdentity("test-user-id", "testuser", "test@example.com")
    private val testAccountKey by lazy { AccountKey.create(app.hubConfig.canonicalOrigin, canonicalIdentity.userId) }

    @Before
    fun setUp() = runBlocking {
        context = ApplicationProvider.getApplicationContext()
        app = TabbyRushApplication.instance
        app.closeActiveRuntime()
        app.clearActiveAccount()
        app.accountFiles.deleteDatabaseAndArtifacts(testAccountKey)
        app.vault.clear(testAccountKey)
        app.accountFiles.clearWipeMarker(testAccountKey)
    }

    @After
    fun tearDown() = runBlocking {
        app.closeActiveRuntime()
        app.clearActiveAccount()
        app.accountFiles.deleteDatabaseAndArtifacts(testAccountKey)
        app.vault.clear(testAccountKey)
        app.accountFiles.clearWipeMarker(testAccountKey)
    }

    private suspend fun awaitUiState(
        viewModel: SessionViewModel,
        timeoutMs: Long = 2_000L,
        condition: (dev.tabbyrush.shared.contract.TodoUiState) -> Boolean
    ) {
        val start = System.currentTimeMillis()
        while (!condition(viewModel.uiState.value) && (System.currentTimeMillis() - start) < timeoutMs) {
            kotlinx.coroutines.delay(20)
        }
        org.junit.Assert.assertTrue("UiState condition timed out after ${timeoutMs}ms", condition(viewModel.uiState.value))
    }

    @Test
    fun testInitialUiState() {
        val viewModel = SessionViewModel()
        val state = viewModel.uiState.value
        assertNotNull("UiState should not be null", state)
        assertEquals(AuthState.UNAUTHENTICATED, state.authState)
        assertEquals(0, state.items.size)
        assertEquals(TodoFilter.ALL, state.filter)
    }

    @Test
    fun testFilterSelectionAction() = runBlocking {
        val viewModel = SessionViewModel()
        viewModel.onAction(TodoAction.SelectFilter(TodoFilter.ACTIVE))
        awaitUiState(viewModel) { it.filter == TodoFilter.ACTIVE }
        assertEquals(TodoFilter.ACTIVE, viewModel.uiState.value.filter)

        viewModel.onAction(TodoAction.SelectFilter(TodoFilter.COMPLETED))
        awaitUiState(viewModel) { it.filter == TodoFilter.COMPLETED }
        assertEquals(TodoFilter.COMPLETED, viewModel.uiState.value.filter)
    }

    @Test
    fun testEditorOpenAndCancel() = runBlocking {
        val viewModel = SessionViewModel()
        viewModel.onAction(TodoAction.OpenCreate("Initial title"))
        awaitUiState(viewModel) { it.editor != null }
        val stateWithEditor = viewModel.uiState.value
        assertNotNull(stateWithEditor.editor)
        assertEquals("Initial title", stateWithEditor.editor?.rawTitle)

        viewModel.onAction(TodoAction.CancelEditor)
        awaitUiState(viewModel) { it.editor == null }
        assertEquals(null, viewModel.uiState.value.editor)
    }

    @Test
    fun testAccountRuntimeCreationAndStoreAccess() = runBlocking {
        app.saveActiveAccount(canonicalIdentity, testAccountKey)
        try {
            val runtime = app.getOrCreateAccountRuntime(testAccountKey)
            assertNotNull(runtime)
            assertEquals(testAccountKey, runtime.accountKey)
            assertNotNull(runtime.store)
            assertNotNull(runtime.coordinator)

            val now = System.currentTimeMillis()
            val taskRef = TaskRef(canonicalIdentity.userId, "todo_device_1")
            val todo = Todo(taskRef = taskRef, title = "Test device task", completed = false, createdAt = now, updatedAt = now)
            runtime.store.saveTodoLocally(todo)
            val todos = runtime.store.loadTodos()
            assertEquals(1, todos.size)
            assertEquals("Test device task", todos[0].title)
        } finally {
            app.closeActiveRuntime()
            app.clearActiveAccount()
            app.accountFiles.deleteDatabaseAndArtifacts(testAccountKey)
        }
    }
}
</file>

<file path="androidApp/src/main/kotlin/dev/tabbyrush/android/account-runtime-factory.kt">
package dev.tabbyrush.android

import android.content.Context
import android.util.Log
import dev.tabbyrush.shared.auth.HubAuthSession
import dev.tabbyrush.shared.auth.HubHttpClient
import dev.tabbyrush.shared.contract.AccountIdentity
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.HubConfig
import dev.tabbyrush.shared.contract.OwnerBindingState
import dev.tabbyrush.shared.remote.DefaultRemoteInboxController
import dev.tabbyrush.shared.data.AndroidAccountFiles
import dev.tabbyrush.shared.data.TabbyRushDatabase
import dev.tabbyrush.shared.data.ReminderOccurrenceStore
import dev.tabbyrush.shared.data.createAndroidDatabaseBuilder
import dev.tabbyrush.shared.sync.AccountLeaveProtocol
import dev.tabbyrush.shared.sync.AccountSyncCoordinator
import dev.tabbyrush.shared.sync.ReminderDeliveryGate
import dev.tabbyrush.shared.sync.ReminderSchedulingCoordinator
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.launch
import dev.tabbyrush.shared.data.RoomAccountStore
import kotlinx.coroutines.flow.collect

/**
 * Factory for instantiating isolated AccountRuntime instances and their
 * constituent coordinators, delivery gates, and leave protocols.
 */
object AccountRuntimeFactory {

    private const val TAG = "AccountRuntimeFactory"

    suspend fun create(
        context: Context,
        scope: CoroutineScope,
        accountKey: AccountKey,
        persistedGen: Long,
        activeIdentity: AccountIdentity?,
        hubConfig: HubConfig,
        accountFiles: AndroidAccountFiles,
        authSession: HubAuthSession,
        syncScheduler: AndroidSyncScheduler
    ): AccountRuntime {
        val establishedIdentity = activeIdentity
            ?: authSession.currentIdentity.value
            ?: throw IllegalStateException("Cannot open runtime without established account identity for $accountKey")
        val userId = establishedIdentity.userId

        val dbFile = accountFiles.getDatabaseFile(accountKey)
        val database = createAndroidDatabaseBuilder(context, dbFile).build()
        val store = RoomAccountStore(accountKey = accountKey, userId = userId, database = database, appId = hubConfig.appId)

        val bindingState = store.initializeOwnerBinding(establishedIdentity)
        if (bindingState != OwnerBindingState.BOUND) {
            Log.w(TAG, "Owner binding state is $bindingState for $accountKey")
        }

        val deliveryGate = ReminderDeliveryGate(
            accountKey = accountKey,
            getPersistedGeneration = { accountFiles.readGeneration(accountKey) },
            hasPendingWipeMarker = { accountFiles.hasPendingWipe(accountKey) }
        )
        val occurrenceStore = ReminderOccurrenceStore(accountKey = accountKey, dao = database.tabbyRushDao())
        val adapter = AndroidNotificationAdapter(context)
        val reminderCoordinator = ReminderSchedulingCoordinator(
            accountKey = accountKey,
            store = store,
            occurrenceStore = occurrenceStore,
            adapter = adapter,
            deliveryGate = deliveryGate,
            getGeneration = { accountFiles.readGeneration(accountKey) },
            hasWipeMarker = { accountFiles.hasPendingWipe(accountKey) }
        )

        val scheduleObserverJob = scope.launch {
            store.observePersistedSchedule().collect {
                try {
                    reminderCoordinator.reconcile()
                } catch (e: Exception) {
                    Log.w(TAG, "Schedule observation reconcile failed: ${e.message}")
                }
            }
        }
        val hostOwner = context.applicationContext as? TaskSurfaceHostOwner
        val surfaceObserverJob = scope.launch {
            launch {
                store.observeTodos().collect {
                    try {
                        hostOwner?.taskSurfaces?.refresh(SurfaceRefreshReason.Data)
                    } catch (e: Exception) {
                        Log.w(TAG, "Todos surface observation refresh failed: ${e.message}")
                    }
                }
            }
            launch {
                store.observePersistedSchedule().collect {
                    try {
                        hostOwner?.taskSurfaces?.refresh(SurfaceRefreshReason.Data)
                    } catch (e: Exception) {
                        Log.w(TAG, "Schedule surface observation refresh failed: ${e.message}")
                    }
                }
            }
        }

        val app = context.applicationContext as? TabbyRushApplication
        val httpClient = HubHttpClient(hubConfig)
        val remoteController = DefaultRemoteInboxController(
            httpClient = httpClient,
            authSession = authSession,
            coroutineScope = scope,
            adapter = app?.remoteNotificationAdapter,
            isDesktop = false
        )

        if (establishedIdentity != null) {
            scope.launch {
                try {
                    remoteController.start(establishedIdentity, persistedGen)
                } catch (e: Exception) {
                    Log.w(TAG, "Failed to start remote inbox controller: ${e.message}")
                }
            }
        }

        app?.installCoordinator?.let { coordinator ->
            scope.launch {
                try {
                    coordinator.onAccountStarted(accountKey.value, userId, persistedGen)
                } catch (e: Exception) {
                    Log.w(TAG, "Failed to start install coordinator for account: ${e.message}")
                }
            }
        }

        val compositeCancelGate = CompositeLeaveSchedulerCancelGate(
            deliveryGate = deliveryGate,
            scheduleObserverJob = scheduleObserverJob,
            syncCancelGate = syncScheduler,
            reminderCancelGate = reminderCoordinator,
            surfaceObserverJob = surfaceObserverJob,
            context = context.applicationContext,
            host = hostOwner?.taskSurfaces,
            remoteController = remoteController,
            remoteAdapter = app?.remoteNotificationAdapter,
            installCoordinator = app?.installCoordinator,
            userId = userId,
            persistedGen = persistedGen
        )

        lateinit var leaveProto: AccountLeaveProtocol
        val coordinator = AccountSyncCoordinator(
            store = store,
            session = authSession,
            leaveProtocolProvider = { leaveProto }
        )
        coordinator.setGeneration(persistedGen)
        leaveProto = createLeaveProtocol(accountKey, store, database, authSession, accountFiles, compositeCancelGate)

        return AccountRuntime(
            accountKey = accountKey,
            generation = persistedGen,
            database = database,
            store = store,
            coordinator = coordinator,
            reminderCoordinator = reminderCoordinator,
            deliveryGate = deliveryGate,
            scheduleObserverJob = scheduleObserverJob,
            leaveProtocol = leaveProto,
            surfaceObserverJob = surfaceObserverJob,
            remoteController = remoteController,
            installCoordinator = app?.installCoordinator
        )
    }

    private fun createLeaveProtocol(
        accountKey: AccountKey,
        store: RoomAccountStore,
        database: TabbyRushDatabase,
        authSession: HubAuthSession,
        accountFiles: AndroidAccountFiles,
        compositeCancelGate: CompositeLeaveSchedulerCancelGate
    ): AccountLeaveProtocol {
        return AccountLeaveProtocol(
            store = store,
            session = authSession,
            onReadGeneration = { accountFiles.readGeneration(it) },
            onWriteGeneration = { key, gen -> accountFiles.writeGeneration(key, gen) },
            onWriteWipeMarker = { key, gen -> accountFiles.writeWipeMarker(key, gen) },
            onClearWipeMarker = { key -> accountFiles.clearWipeMarker(key) },
            onDeleteDatabaseArtifacts = { key ->
                try { database.close() } catch (e: Exception) { Log.e(TAG, "Error closing database: ${e.message}", e) }
                accountFiles.deleteDatabaseAndArtifacts(key)
            },
            schedulerCancelGate = compositeCancelGate
        )
    }
}
</file>

