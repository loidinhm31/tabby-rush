<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/remote/remote-inbox-client.kt">
package dev.tabbyrush.shared.remote

import dev.tabbyrush.shared.auth.HubAuthSession
import dev.tabbyrush.shared.auth.HubHttpClient
import dev.tabbyrush.shared.contract.ApiResult
import dev.tabbyrush.shared.contract.RemoteBindingResult
import dev.tabbyrush.shared.contract.RemoteBindingStatus
import dev.tabbyrush.shared.contract.RemoteInboxItem
import dev.tabbyrush.shared.contract.RemoteInboxPage
import dev.tabbyrush.shared.contract.RemoteReadResult
import dev.tabbyrush.shared.contract.RemoteUnreadResponse
import dev.tabbyrush.shared.contract.SafeError
import io.ktor.client.statement.bodyAsText
import io.ktor.http.HttpMethod
import io.ktor.http.HttpStatusCode
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json

@Serializable
data class BindRequest(
    val operationGeneration: String,
    val platform: String,
    val token: String,
    val appVersion: String
)

typealias RemoteBindRequest = BindRequest

@Serializable
data class UnbindRequest(
    val operationGeneration: String,
    val expectedBindingGeneration: String
)

typealias RemoteUnbindRequest = UnbindRequest

class RemoteInboxClient(
    val httpClient: HubHttpClient,
    val authSession: HubAuthSession
) {
    private val json = Json {
        ignoreUnknownKeys = true
        isLenient = false
        encodeDefaults = true
    }

    suspend fun fetchInbox(
        limit: Int = 25,
        cursor: String? = null
    ): ApiResult<RemoteInboxPage> {
        val queryParams = buildList {
            add("limit=$limit")
            if (cursor != null) add("cursor=$cursor")
        }.joinToString("&")
        val path = "/api/v1/apps/${httpClient.config.appId}/announcements/inbox?$queryParams"

        return executeWithRetry { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Get,
                path = path,
                accessToken = token
            )
            parseResult(result, path, RemoteInboxPage.serializer())
        }
    }

    suspend fun fetchUnread(): ApiResult<RemoteUnreadResponse> {
        val path = "/api/v1/apps/${httpClient.config.appId}/announcements/unread"
        return executeWithRetry { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Get,
                path = path,
                accessToken = token
            )
            parseResult(result, path, RemoteUnreadResponse.serializer())
        }
    }

    suspend fun fetchDetail(id: String): ApiResult<RemoteInboxItem> {
        val path = "/api/v1/apps/${httpClient.config.appId}/announcements/inbox/$id"
        return executeWithRetry { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Get,
                path = path,
                accessToken = token
            )
            parseResult(result, path, RemoteInboxItem.serializer())
        }
    }

    suspend fun markRead(id: String): ApiResult<RemoteReadResult> {
        val path = "/api/v1/apps/${httpClient.config.appId}/announcements/inbox/$id/read"
        return executeWithRetry { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Put,
                path = path,
                accessToken = token,
                bodyJson = "{}"
            )
            parseResult(result, path, RemoteReadResult.serializer())
        }
    }

    suspend fun bindInstall(
        installId: String,
        proof: String,
        request: BindRequest
    ): ApiResult<RemoteBindingResult> {
        val path = "/api/v1/apps/${httpClient.config.appId}/notification-installs/$installId/binding"
        val bodyJson = json.encodeToString(BindRequest.serializer(), request)
        // Device operation: does not silently replay on TOKEN_REFRESHED; caller retains intent
        return authSession.authorizedRequest { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Put,
                path = path,
                accessToken = token,
                bodyJson = bodyJson,
                installProof = proof
            )
            parseResult(result, path, RemoteBindingResult.serializer())
        }
    }

    suspend fun unbindInstall(
        installId: String,
        proof: String,
        request: UnbindRequest,
        accessTokenOverride: String? = null
    ): ApiResult<RemoteBindingResult> {
        val path = "/api/v1/apps/${httpClient.config.appId}/notification-installs/$installId/unbind"
        val bodyJson = json.encodeToString(UnbindRequest.serializer(), request)

        if (accessTokenOverride != null) {
            val result = httpClient.executeRaw(
                method = HttpMethod.Post,
                path = path,
                accessToken = accessTokenOverride,
                bodyJson = bodyJson,
                installProof = proof
            )
            return parseResult(result, path, RemoteBindingResult.serializer())
        }

        return authSession.authorizedRequest { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Post,
                path = path,
                accessToken = token,
                bodyJson = bodyJson,
                installProof = proof
            )
            parseResult(result, path, RemoteBindingResult.serializer())
        }
    }

    suspend fun getInstallBinding(
        installId: String,
        proof: String
    ): ApiResult<RemoteBindingStatus> {
        val path = "/api/v1/apps/${httpClient.config.appId}/notification-installs/$installId/binding"
        return executeWithRetry { token ->
            val result = httpClient.executeRaw(
                method = HttpMethod.Get,
                path = path,
                accessToken = token,
                installProof = proof
            )
            parseResult(result, path, RemoteBindingStatus.serializer())
        }
    }

    private suspend fun <T> executeWithRetry(
        block: suspend (accessToken: String) -> ApiResult<T>
    ): ApiResult<T> {
        val firstAttempt = authSession.authorizedRequest(block = block)
        if (firstAttempt is ApiResult.Failure &&
            firstAttempt.error is SafeError.Unauthorized &&
            firstAttempt.error.code == "TOKEN_REFRESHED"
        ) {
            return authSession.authorizedRequest(block = block)
        }
        return firstAttempt
    }

    private suspend fun <T> parseResult(
        responseResult: ApiResult<io.ktor.client.statement.HttpResponse>,
        path: String,
        serializer: kotlinx.serialization.KSerializer<T>
    ): ApiResult<T> {
        return when (responseResult) {
            is ApiResult.Failure -> responseResult
            is ApiResult.Success -> {
                val response = responseResult.value
                if (response.status == HttpStatusCode.OK ||
                    response.status == HttpStatusCode.Created ||
                    response.status == HttpStatusCode.Accepted
                ) {
                    try {
                        val text = response.bodyAsText()
                        val parsed = json.decodeFromString(serializer, text)
                        ApiResult.Success(parsed)
                    } catch (e: Exception) {
                        ApiResult.Failure(
                            SafeError.ProtocolIncompatible(
                                code = "JSON_PARSE_ERROR",
                                message = "Failed to parse response from $path: ${e.message}"
                            )
                        )
                    }
                } else {
                    val error = httpClient.parseResponseError(response, path)
                    ApiResult.Failure(error)
                }
            }
        }
    }
}
</file>

<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/remote/remote-stream-client.kt">
package dev.tabbyrush.shared.remote

import dev.tabbyrush.shared.auth.HubAuthSession
import dev.tabbyrush.shared.auth.HubHttpClient
import dev.tabbyrush.shared.contract.ApiResult
import dev.tabbyrush.shared.contract.SafeError
import io.ktor.client.call.body
import io.ktor.http.HttpStatusCode
import io.ktor.utils.io.ByteReadChannel
import io.ktor.utils.io.readUTF8Line
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json

@Serializable
data class SseReadyData(
    val protocol: Int,
    val appId: String,
    val streamEpoch: String,
    val baselineAcceptanceOrdinal: String,
    val baselineHintSequence: String,
    val serverNow: String,
    val replaySupported: Boolean = false
)

@Serializable
data class SseAnnouncementData(
    val appId: String,
    val messageId: String,
    val acceptanceEpoch: String,
    val acceptanceOrdinal: String,
    val acceptedAt: String,
    val expiresAt: String,
    val emittedAt: String,
    val liveEligible: Boolean
)

@Serializable
data class SseReadStateData(
    val appId: String,
    val messageId: String
)

@Serializable
data class SseReconcileData(
    val appId: String,
    val reason: String
)

sealed interface RemoteStreamEvent {
    data class Ready(val id: String?, val data: SseReadyData) : RemoteStreamEvent
    data class Announcement(val id: String?, val data: SseAnnouncementData) : RemoteStreamEvent
    data class ReadState(val id: String?, val data: SseReadStateData) : RemoteStreamEvent
    data class Reconcile(val id: String?, val data: SseReconcileData) : RemoteStreamEvent
    data object Keepalive : RemoteStreamEvent
}

class OversizedFrameException(message: String) : Exception(message)
class MalformedFrameException(message: String) : Exception(message)

class SseStreamParser(
    private val json: Json = Json {
        ignoreUnknownKeys = true
        isLenient = false
        encodeDefaults = true
    }
) {
    companion object {
        const val MAX_FRAME_BYTES = 16 * 1024 // 16 KiB
    }

    private var currentEventType = ""
    private var currentId: String? = null
    private val dataLines = mutableListOf<String>()
    private var currentFrameBytes = 0

    fun parseLine(line: String): RemoteStreamEvent? {
        val lineBytes = line.encodeToByteArray().size
        currentFrameBytes += lineBytes + 1
        if (currentFrameBytes > MAX_FRAME_BYTES) {
            reset()
            throw OversizedFrameException("SSE frame exceeded $MAX_FRAME_BYTES bytes")
        }

        if (line.isEmpty()) {
            if (dataLines.isEmpty() && currentEventType.isEmpty() && currentId == null) {
                reset()
                return null
            }
            val eventType = currentEventType
            val eventId = currentId
            val dataStr = dataLines.joinToString("\n")
            reset()

            return parseEventPayload(eventType, eventId, dataStr)
        }

        if (line.startsWith(":")) {
            return RemoteStreamEvent.Keepalive
        }

        val colonIndex = line.indexOf(':')
        val field = if (colonIndex != -1) line.substring(0, colonIndex) else line
        var value = if (colonIndex != -1) line.substring(colonIndex + 1) else ""
        if (value.startsWith(" ")) {
            value = value.substring(1)
        }

        when (field) {
            "event" -> currentEventType = value
            "data" -> dataLines.add(value)
            "id" -> currentId = value
        }
        return null
    }

    private fun parseEventPayload(eventType: String, id: String?, data: String): RemoteStreamEvent {
        return try {
            when (eventType) {
                "ready" -> {
                    val payload = json.decodeFromString(SseReadyData.serializer(), data)
                    RemoteStreamEvent.Ready(id, payload)
                }
                "announcement" -> {
                    val payload = json.decodeFromString(SseAnnouncementData.serializer(), data)
                    RemoteStreamEvent.Announcement(id, payload)
                }
                "read-state" -> {
                    val payload = json.decodeFromString(SseReadStateData.serializer(), data)
                    RemoteStreamEvent.ReadState(id, payload)
                }
                "reconcile" -> {
                    val payload = json.decodeFromString(SseReconcileData.serializer(), data)
                    RemoteStreamEvent.Reconcile(id, payload)
                }
                else -> throw MalformedFrameException("Unknown event type: '$eventType'")
            }
        } catch (e: Exception) {
            if (e is MalformedFrameException) throw e
            throw MalformedFrameException("Failed to decode SSE data for event '$eventType': ${e.message}")
        }
    }

    fun reset() {
        currentEventType = ""
        currentId = null
        dataLines.clear()
        currentFrameBytes = 0
    }
}

class RemoteStreamClient(
    val httpClient: HubHttpClient,
    val authSession: HubAuthSession
) {
    private val json = Json {
        ignoreUnknownKeys = true
        isLenient = false
        encodeDefaults = true
    }

    suspend fun parseChannel(
        channel: ByteReadChannel,
        emit: suspend (RemoteStreamEvent) -> Unit
    ) {
        val parser = SseStreamParser(json)
        try {
            while (!channel.isClosedForRead) {
                val line = try {
                    channel.readUTF8Line(16 * 1024) ?: break
                } catch (e: Exception) {
                    throw OversizedFrameException("SSE line exceeded 16KiB limit: ${e.message}")
                }
                val event = parser.parseLine(line)
                if (event != null) {
                    emit(event)
                }
            }
        } finally {
            parser.reset()
        }
    }

    suspend fun openAndConsumeStream(
        path: String = "/api/v1/apps/${httpClient.config.appId}/announcements/stream",
        lastEventId: String? = null,
        onRevoked: suspend () -> Unit = {},
        onEvent: suspend (RemoteStreamEvent) -> Unit
    ): ApiResult<Unit> {
        val block: suspend (String) -> ApiResult<Unit> = { token ->
            try {
                val statement = httpClient.prepareStream(
                    path = path,
                    accessToken = token,
                    lastEventId = lastEventId
                )
                statement.execute { response ->
                    if (response.status == HttpStatusCode.OK) {
                        val channel: ByteReadChannel = response.body()
                        parseChannel(channel, onEvent)
                        ApiResult.Success(Unit)
                    } else if (response.status == HttpStatusCode.Unauthorized) {
                        ApiResult.Failure(
                            SafeError.Unauthorized(
                                code = "UNAUTHORIZED",
                                message = "Stream connection unauthorized (HTTP 401)"
                            )
                        )
                    } else {
                        val error = httpClient.parseResponseError(response, path)
                        ApiResult.Failure(error)
                    }
                }
            } catch (c: kotlinx.coroutines.CancellationException) {
                throw c
            } catch (e: OversizedFrameException) {
                ApiResult.Failure(SafeError.Network("OVERSIZED_FRAME", e.message ?: "Oversized frame"))
            } catch (e: MalformedFrameException) {
                ApiResult.Failure(SafeError.ProtocolIncompatible("MALFORMED_FRAME", e.message ?: "Malformed frame"))
            } catch (e: Exception) {
                ApiResult.Failure(SafeError.Network("STREAM_ERROR", e.message ?: "Stream failure"))
            }
        }

        var result = authSession.authorizedRequest(block = block)
        if (result is ApiResult.Failure &&
            result.error is SafeError.Unauthorized &&
            result.error.code == "TOKEN_REFRESHED"
        ) {
            // Replay open at most once after TOKEN_REFRESHED
            result = authSession.authorizedRequest(block = block)
        }

        if (result is ApiResult.Failure) {
            if (result.error.code == "appAccessRevoked" ||
                (result.error is SafeError.AccessPending && result.error.code == "appAccessRevoked")
            ) {
                onRevoked()
            }
        }

        return result
    }
}
</file>

<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/sync/account-leave-protocol.kt">
package dev.tabbyrush.shared.sync

import dev.tabbyrush.shared.auth.HubAuthSession
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.data.OutboxEntity
import dev.tabbyrush.shared.data.RoomAccountStore

/**
 * LeaveReviewCounts represents unresolved local work that must be reviewed
 * before executing a standard account leave.
 */
data class LeaveReviewCounts(
    val draftCount: Int,
    val pendingCount: Int,
    val uncertainCount: Int,
    val conflictCount: Int,
    val unknownSupersededCount: Int
) {
    val totalUnresolved: Int
        get() = draftCount + pendingCount + uncertainCount + conflictCount + unknownSupersededCount

    val hasReviewWork: Boolean
        get() = totalUnresolved > 0
}

/**
 * Hook to await background WorkManager or job scheduler cancellation.
 */
fun interface LeaveSchedulerCancelGate {
    suspend fun cancelAndAwait(accountKey: AccountKey)
}

/**
 * AccountLeaveProtocol enforces the crash-safe, fail-closed account leave sequence (C7):
 * 1. Count unresolved work (drafts, pending, uncertain, conflict, unknownSuperseded).
 * 2. Guard against leave unless work is resolved or explicit discard is requested.
 * 3. Exact teardown order:
 *    a. Freeze edits and scheduling.
 *    b. Increment and persist next generation + wipe marker outside the database.
 *       (Abort before deleting anything if persistence fails).
 *    c. Cancel and await scheduler and owned background jobs. (Fails closed on error).
 *    d. Close Room database connection.
 *    e. Delete database files (DB, WAL, SHM).
 *       (If deletion fails, remain fail-closed with marker intact).
 *    f. Remove credentials from CredentialVault and clear session.
 *    g. Clear wipe marker.
 */
class AccountLeaveProtocol(
    val store: RoomAccountStore,
    val session: HubAuthSession,
    val onReadGeneration: (AccountKey) -> Long = { 0L },
    val onWriteGeneration: (AccountKey, Long) -> Unit = { _, _ -> },
    val onWriteWipeMarker: (AccountKey, Long) -> Unit,
    val onClearWipeMarker: (AccountKey) -> Unit,
    val onDeleteDatabaseArtifacts: (AccountKey) -> Boolean,
    val schedulerCancelGate: LeaveSchedulerCancelGate? = null
) {

    suspend fun checkReviewWork(): LeaveReviewCounts {
        val draftCount = store.dao.countDrafts()
        val pendingCount = store.dao.countOutboxByState(OutboxEntity.STATE_PENDING) +
                store.dao.countOutboxByState(OutboxEntity.STATE_DISPATCHING)
        val uncertainCount = store.dao.countOutboxByState(OutboxEntity.STATE_UNCERTAIN)
        val conflictCount = store.dao.countOutboxByState(OutboxEntity.STATE_CONFLICT)
        val unknownSupersededCount = store.dao.countOutboxByState(OutboxEntity.STATE_REVIEW)

        return LeaveReviewCounts(
            draftCount = draftCount,
            pendingCount = pendingCount,
            uncertainCount = uncertainCount,
            conflictCount = conflictCount,
            unknownSupersededCount = unknownSupersededCount
        )
    }

    suspend fun executeLeave(): Boolean {
        // Freeze store before review check so no intervening edit occurs (W-A)
        store.isFrozen = true
        val review = checkReviewWork()
        if (review.hasReviewWork) {
            store.isFrozen = false
            return false // Guarded: Cannot leave without resolving pending work or discarding
        }
        return performGuardedTeardown()
    }

    suspend fun discardAndLeave(): Boolean {
        return performGuardedTeardown()
    }

    private suspend fun performGuardedTeardown(): Boolean {
        // a. Freeze edits and scheduling (C7)
        store.isFrozen = true

        // Close delivery gate and drain in-flight callbacks and mutations before DB closure
        val drained = store.deliveryGate?.closeAndDrain(5000L) ?: true
        if (!drained) {
            return false // Drain timeout: remain frozen fail-closed without deleting artifacts
        }
        val accountKey = store.accountKey

        // b. Increment and persist new generation + wipe marker outside the database (C7)
        val currentGen = try {
            onReadGeneration(accountKey)
        } catch (_: Exception) {
            // Generation read failure: abort fail-closed
            return false
        }
        if (currentGen == Long.MAX_VALUE) {
            // Overflow: abort fail-closed
            return false
        }
        val nextGeneration = currentGen + 1L

        try {
            onWriteGeneration(accountKey, nextGeneration)
            onWriteWipeMarker(accountKey, nextGeneration)
        } catch (_: Exception) {
            // Failed marker persistence aborts leave before deleting anything; remains fail-closed
            return false
        }

        // c. Cancel and await scheduler / background work (fail-closed if cancelled/failed) (C7, Phase 07)
        try {
            schedulerCancelGate?.cancelAndAwait(accountKey)
        } catch (_: Exception) {
            // Phase 07: Failed cancellation retains wipe marker and remains frozen fail-closed!
            return false
        }

        // d. Close Room database handles
        store.close()

        // e. Delete DB, WAL, SHM, and artifacts
        val deleted = try {
            onDeleteDatabaseArtifacts(accountKey)
        } catch (_: Exception) {
            false
        }

        if (!deleted) {
            // Failed deletion stays fail-closed with wipe marker intact!
            return false
        }

        // f. Remove credentials from vault and clear session
        session.logout()

        // g. Clear wipe marker
        try {
            onClearWipeMarker(accountKey)
        } catch (_: Exception) {
            // Benign if marker already gone
        }

        return true
    }

    companion object {
        /**
         * Startup crash recovery: checks if a pending wipe was interrupted,
         * and completes file deletion and credential cleanup before opening (C7).
         */
        suspend fun completePendingWipe(
            accountKey: AccountKey,
            hasPendingWipe: (AccountKey) -> Boolean,
            onDeleteDatabaseArtifacts: (AccountKey) -> Boolean,
            onClearVault: suspend (AccountKey) -> Unit,
            onClearWipeMarker: (AccountKey) -> Unit,
            schedulerCancelGate: LeaveSchedulerCancelGate? = null
        ): Boolean {
            if (!hasPendingWipe(accountKey)) {
                return false
            }
            try {
                schedulerCancelGate?.cancelAndAwait(accountKey)
            } catch (_: Exception) {
                return false // Retain wipe marker if scheduler cancellation fails
            }
            val deleted = onDeleteDatabaseArtifacts(accountKey)
            if (deleted) {
                onClearVault(accountKey)
                onClearWipeMarker(accountKey)
            }
            return deleted
        }
    }
}
</file>

