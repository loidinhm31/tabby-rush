                        }
                        TextButton(
                            onClick = { navState = navState.navigateToList() },
                            modifier = Modifier.fillMaxWidth().defaultMinSize(minHeight = TabbyRushThemeTokens.MinTouchTargetSize)
                        ) {
                            Row(
