                                "deadlineOffsetSeconds":0,
                                "deadlineAnchorEpochMs":1793836800000,
                                "deadlineOverdueEpochMs":1793923200000,
                                "reminderAnchorTime":"09:00",
                                "reminderEnabled":false,
                                "reminderLeadMinutes":0,
                                "reminderCount":1,
