        EditorDraftEntity::class,
        ScanStagingEntity::class,
        AccountSyncMetaEntity::class,
        AccountLocalSettingsEntity::class,
        ReminderDeliveryLedgerEntity::class
    ],
    version = 2,
    exportSchema = true
)
