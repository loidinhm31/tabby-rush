package dev.tabbyrush.desktop

/**
 * Representation of sticky window logical geometry in device-independent pixels (dp)
 * along with display scale conversion metadata.
 */
data class StickyWindowGeometry(
    val xDp: Double,
    val yDp: Double,
    val widthDp: Double,
    val heightDp: Double,
    val savedScaleX: Double,
    val savedScaleY: Double
)

/**
 * Work area of a connected display monitor in normalized AWT user-space logical units (dp).
 * The work area accounts for system insets (taskbars, docks, menu bars).
 */
data class MonitorWorkArea(
    val id: String,
    val primary: Boolean,
    val xDp: Double,
    val yDp: Double,
    val widthDp: Double,
    val heightDp: Double,
    val scaleX: Double,
    val scaleY: Double
)

/**
 * Presentation state persisted for the sticky window across sessions.
 */
data class StickyWindowPresentation(
    val visible: Boolean,
    val geometry: StickyWindowGeometry,
    val fontScale: Float = DEFAULT_STICKY_FONT_SCALE
)

const val DEFAULT_STICKY_FONT_SCALE = 1.0f
const val MIN_STICKY_FONT_SCALE = 0.50f
const val MAX_STICKY_FONT_SCALE = 1.50f
const val STICKY_FONT_SCALE_STEP = 0.125f

/**
 * Validates whether the given font scale is finite and within allowed bounds.
 */
fun isValidStickyFontScale(scale: Float): Boolean {
    return scale.isFinite() && scale in MIN_STICKY_FONT_SCALE..MAX_STICKY_FONT_SCALE
}

/**
 * Computes effective sticky font scale derived from current unscaled window width
 * relative to [referenceWidthDp] multiplied by user manual zoom preference.
 *
 * Typography uses width-driven scaling so shortening vertical height does not shrink
 * text into unreadable sizes while vertical scroll containment handles height constraints.
 */
fun computeEffectiveStickyFontScale(
    windowWidthDp: Double,
    manualZoom: Float = DEFAULT_STICKY_FONT_SCALE,
    referenceWidthDp: Double = DEFAULT_STICKY_WIDTH_DP,
    minScale: Float = MIN_STICKY_FONT_SCALE,
    maxScale: Float = MAX_STICKY_FONT_SCALE
): Float {
    val safeManual = if (isValidStickyFontScale(manualZoom)) manualZoom else DEFAULT_STICKY_FONT_SCALE
    val windowFactor = if (referenceWidthDp > 0.0 && windowWidthDp.isFinite() && windowWidthDp > 0.0) {
        (windowWidthDp / referenceWidthDp).toFloat()
    } else {
        1.0f
    }
    val rawEffective = windowFactor * safeManual
    return rawEffective.coerceIn(minScale, maxScale)
}
const val DEFAULT_STICKY_WIDTH_DP = 360.0
const val DEFAULT_STICKY_HEIGHT_DP = 520.0
const val MIN_STICKY_WIDTH_DP = 280.0
const val MIN_STICKY_HEIGHT_DP = 240.0
const val MIN_CONTENT_VISIBLE_DP = 48.0
const val MIN_TITLE_BAR_VISIBLE_DP = 32.0

/**
 * Validates whether the given geometry values are finite and non-empty.
 */
fun isValidStickyGeometry(geometry: StickyWindowGeometry): Boolean {
    return geometry.xDp.isFinite() &&
        geometry.yDp.isFinite() &&
        geometry.widthDp.isFinite() && geometry.widthDp > 0.0 &&
        geometry.heightDp.isFinite() && geometry.heightDp > 0.0 &&
        geometry.savedScaleX.isFinite() && geometry.savedScaleX > 0.0 &&
        geometry.savedScaleY.isFinite() && geometry.savedScaleY > 0.0
}

/**
 * Validates whether the monitor work area values are finite and non-empty.
 */
fun isValidMonitorWorkArea(monitor: MonitorWorkArea): Boolean {
    return monitor.xDp.isFinite() &&
        monitor.yDp.isFinite() &&
        monitor.widthDp.isFinite() && monitor.widthDp > 0.0 &&
        monitor.heightDp.isFinite() && monitor.heightDp > 0.0 &&
        monitor.scaleX.isFinite() && monitor.scaleX > 0.0 &&
        monitor.scaleY.isFinite() && monitor.scaleY > 0.0
}

/**
 * Restores and clamps sticky window geometry against the current active monitor work areas.
 *
 * Rules:
 * 1. If [monitors] is empty or contains no valid monitor, returns reachable default geometry (0,0, 360x520, scale 1.0).
 * 2. If [saved] is null or corrupt (NaN, infinite, non-positive dimensions/scale), falls back to default 360x520
 *    centered on the primary monitor (or first available).
 * 3. Identifies target monitor by maximum intersection area. If the saved window has zero intersection with all
 *    currently connected monitors (e.g. secondary monitor was unplugged), falls back to the primary (or first) monitor.
 * 4. Preserves legitimate negative origins (e.g. secondary display positioned to the left of or above the primary).
 * 5. Clamps dimensions to at least [MIN_STICKY_WIDTH_DP] x [MIN_STICKY_HEIGHT_DP], unless the monitor work area itself
 *    is smaller than minimums (in which case dimensions clamp to the work area).
 * 6. Clamps position so the entire title bar is reachable (yDp >= monitor.yDp and within horizontal bounds)
 *    and content is visible within the usable work area.
 * 7. Records the target monitor's current display scale in the returned geometry.
 */
fun restoreStickyGeometry(
    saved: StickyWindowGeometry?,
    monitors: List<MonitorWorkArea>
): StickyWindowGeometry {
    val validMonitors = monitors.filter { isValidMonitorWorkArea(it) }
    if (validMonitors.isEmpty()) {
        val safeSaved = saved?.takeIf { isValidStickyGeometry(it) }
        return safeSaved ?: StickyWindowGeometry(
            xDp = 0.0,
            yDp = 0.0,
            widthDp = DEFAULT_STICKY_WIDTH_DP,
            heightDp = DEFAULT_STICKY_HEIGHT_DP,
            savedScaleX = 1.0,
            savedScaleY = 1.0
        )
    }

    val primaryMonitor = validMonitors.firstOrNull { it.primary } ?: validMonitors.first()

    if (saved == null || !isValidStickyGeometry(saved)) {
        val clampedW = minOf(DEFAULT_STICKY_WIDTH_DP, primaryMonitor.widthDp)
        val clampedH = minOf(DEFAULT_STICKY_HEIGHT_DP, primaryMonitor.heightDp)
        val clampedX = primaryMonitor.xDp + maxOf(0.0, (primaryMonitor.widthDp - clampedW) / 2.0)
        val clampedY = primaryMonitor.yDp + maxOf(0.0, (primaryMonitor.heightDp - clampedH) / 2.0)
        return StickyWindowGeometry(
            xDp = clampedX,
            yDp = clampedY,
            widthDp = clampedW,
            heightDp = clampedH,
            savedScaleX = primaryMonitor.scaleX,
            savedScaleY = primaryMonitor.scaleY
        )
    }

    // Determine target monitor based on maximum intersection area with saved bounds
    var maxIntersectionArea = 0.0
    var candidateMonitors = mutableListOf<MonitorWorkArea>()

    for (monitor in validMonitors) {
        val overlapLeft = maxOf(saved.xDp, monitor.xDp)
        val overlapTop = maxOf(saved.yDp, monitor.yDp)
        val overlapRight = minOf(saved.xDp + saved.widthDp, monitor.xDp + monitor.widthDp)
        val overlapBottom = minOf(saved.yDp + saved.heightDp, monitor.yDp + monitor.heightDp)
        val overlapWidth = maxOf(0.0, overlapRight - overlapLeft)
        val overlapHeight = maxOf(0.0, overlapBottom - overlapTop)
        val area = overlapWidth * overlapHeight

        if (area > maxIntersectionArea) {
            maxIntersectionArea = area
            candidateMonitors = mutableListOf(monitor)
        } else if (area > 0.0 && area == maxIntersectionArea) {
            candidateMonitors.add(monitor)
        }
    }

    val (targetMonitor, hasIntersection) = if (maxIntersectionArea > 0.0) {
        val selected = candidateMonitors.firstOrNull { it.primary }
            ?: candidateMonitors.minByOrNull { it.id }
            ?: candidateMonitors.first()
        Pair(selected, true)
    } else {
        // Disconnected monitor fallback
        Pair(primaryMonitor, false)
    }

    // Clamp dimensions to target monitor work area and minimum constraints
    val effectiveMinWidth = minOf(MIN_STICKY_WIDTH_DP, targetMonitor.widthDp)
    val effectiveMinHeight = minOf(MIN_STICKY_HEIGHT_DP, targetMonitor.heightDp)
    val effectiveMaxWidth = targetMonitor.widthDp
    val effectiveMaxHeight = targetMonitor.heightDp

    val clampedWidth = saved.widthDp.coerceIn(
        effectiveMinWidth,
        maxOf(effectiveMinWidth, effectiveMaxWidth)
    )
    val clampedHeight = saved.heightDp.coerceIn(
        effectiveMinHeight,
        maxOf(effectiveMinHeight, effectiveMaxHeight)
    )

    // Clamp position ensuring title bar reachability and content visibility
    val clampedX: Double
    val clampedY: Double

    if (!hasIntersection) {
        // Fallback placement: center within the target monitor work area
        clampedX = targetMonitor.xDp + maxOf(0.0, (targetMonitor.widthDp - clampedWidth) / 2.0)
        clampedY = targetMonitor.yDp + maxOf(0.0, (targetMonitor.heightDp - clampedHeight) / 2.0)
    } else {
        // Horizontal clamp: entire title bar must be within work area bounds
        val maxX = maxOf(targetMonitor.xDp, targetMonitor.xDp + targetMonitor.widthDp - clampedWidth)
        clampedX = saved.xDp.coerceIn(targetMonitor.xDp, maxX)

        // Vertical clamp: top edge (title bar) must be at least monitor.yDp (reachable),
        // and window must not extend below the usable work area
        val maxY = maxOf(targetMonitor.yDp, targetMonitor.yDp + targetMonitor.heightDp - clampedHeight)
        clampedY = saved.yDp.coerceIn(targetMonitor.yDp, maxY)
    }

    return StickyWindowGeometry(
        xDp = clampedX,
        yDp = clampedY,
        widthDp = clampedWidth,
        heightDp = clampedHeight,
        savedScaleX = targetMonitor.scaleX,
        savedScaleY = targetMonitor.scaleY
    )
}
</file>

<file path="desktopApp/src/main/kotlin/dev/tabbyrush/desktop/sticky-window-preferences.kt">
package dev.tabbyrush.desktop

import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.nio.file.AtomicMoveNotSupportedException
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import java.util.Properties
import java.util.UUID

/**
 * Atomic local persistence for sticky window presentation settings (geometry and visibility).
 * Stored outside Room/database in a dedicated properties file.
 *
 * Guarantees:
 * - Atomic write via temporary file in the same parent directory + fsync + ATOMIC_MOVE.
 * - Defensive recovery from missing, partial, or corrupted files falling back to default hidden presentation.
 * - Thread-safe synchronization on the instance level (single-writer within the process).
 * - Stores strictly presentation metadata; never contains account or task content.
 */
class StickyWindowPreferences(val file: File) {

    private val lock = Any()

    companion object {
        const val CURRENT_VERSION = 1
        const val KEY_VERSION = "version"
        const val KEY_VISIBLE = "visible"
        const val KEY_VISIBLE_ON_LAUNCH_ALIAS = "isVisibleOnLaunch"
        const val KEY_X_DP = "xDp"
        const val KEY_Y_DP = "yDp"
        const val KEY_WIDTH_DP = "widthDp"
        const val KEY_HEIGHT_DP = "heightDp"
        const val KEY_SCALE_X = "savedScaleX"
        const val KEY_SCALE_Y = "savedScaleY"
        const val KEY_FONT_SCALE = "fontScale"
        const val KEY_FONT_SCALE_ALIAS = "sticky.window.font_scale"

        val DEFAULT_PRESENTATION = StickyWindowPresentation(
            visible = false,
            geometry = StickyWindowGeometry(
                xDp = 0.0,
                yDp = 0.0,
                widthDp = DEFAULT_STICKY_WIDTH_DP,
                heightDp = DEFAULT_STICKY_HEIGHT_DP,
                savedScaleX = 1.0,
                savedScaleY = 1.0
            ),
            fontScale = DEFAULT_STICKY_FONT_SCALE
        )
    }

    /**
     * Loads the persisted presentation state. If the file is missing, empty, or contains
     * invalid/corrupted values, returns [DEFAULT_PRESENTATION] without throwing.
     */
    fun load(): StickyWindowPresentation = synchronized(lock) {
        if (!file.exists() || !file.isFile || file.length() == 0L) {
            return DEFAULT_PRESENTATION
        }

        return try {
            val properties = Properties()
            FileInputStream(file).use { fis ->
                properties.load(fis)
            }

            val version = properties.getProperty(KEY_VERSION)?.toIntOrNull() ?: CURRENT_VERSION
            if (version < 1) {
                return DEFAULT_PRESENTATION
            }

            val visibleStr = properties.getProperty(KEY_VISIBLE)
                ?: properties.getProperty(KEY_VISIBLE_ON_LAUNCH_ALIAS)
            val visible = visibleStr?.toBooleanStrictOrNull() ?: false

            val xDp = properties.getProperty(KEY_X_DP)?.toDoubleOrNull() ?: 0.0
            val yDp = properties.getProperty(KEY_Y_DP)?.toDoubleOrNull() ?: 0.0
            val widthDp = properties.getProperty(KEY_WIDTH_DP)?.toDoubleOrNull() ?: DEFAULT_STICKY_WIDTH_DP
            val heightDp = properties.getProperty(KEY_HEIGHT_DP)?.toDoubleOrNull() ?: DEFAULT_STICKY_HEIGHT_DP
            val scaleX = properties.getProperty(KEY_SCALE_X)?.toDoubleOrNull() ?: 1.0
            val scaleY = properties.getProperty(KEY_SCALE_Y)?.toDoubleOrNull() ?: 1.0

            val rawFontScaleStr = properties.getProperty(KEY_FONT_SCALE)
                ?: properties.getProperty(KEY_FONT_SCALE_ALIAS)
            val rawFontScale = rawFontScaleStr?.toFloatOrNull()
            val fontScale = if (rawFontScale != null && isValidStickyFontScale(rawFontScale)) {
                rawFontScale
            } else {
                DEFAULT_STICKY_FONT_SCALE
            }

            val candidateGeometry = StickyWindowGeometry(
                xDp = xDp,
                yDp = yDp,
                widthDp = widthDp,
                heightDp = heightDp,
                savedScaleX = scaleX,
                savedScaleY = scaleY
            )

            if (!isValidStickyGeometry(candidateGeometry)) {
                DEFAULT_PRESENTATION.copy(visible = visible, fontScale = fontScale)
            } else {
                StickyWindowPresentation(
                    visible = visible,
                    geometry = candidateGeometry,
                    fontScale = fontScale
                )
            }
        } catch (_: Exception) {
            DEFAULT_PRESENTATION
        }
    }

    /**
     * Atomically persists the presentation state to [file] using a UUID-named temporary file
     * in the parent directory, fsync, and atomic rename.
     *
     * In the event of an I/O error, the operation fails safely without corrupting the existing file.
     */
    fun save(presentation: StickyWindowPresentation): Unit = synchronized(lock) {
        val parentDir = file.canonicalFile.parentFile ?: file.absoluteFile.parentFile
        if (parentDir != null && !parentDir.exists()) {
            parentDir.mkdirs()
        }

        val tempFile = File(parentDir, "${file.name}.${UUID.randomUUID()}.tmp")
        try {
            val properties = Properties()
            properties.setProperty(KEY_VERSION, CURRENT_VERSION.toString())
            properties.setProperty(KEY_VISIBLE, presentation.visible.toString())
            properties.setProperty(KEY_X_DP, presentation.geometry.xDp.toString())
            properties.setProperty(KEY_Y_DP, presentation.geometry.yDp.toString())
            properties.setProperty(KEY_WIDTH_DP, presentation.geometry.widthDp.toString())
            properties.setProperty(KEY_HEIGHT_DP, presentation.geometry.heightDp.toString())
            properties.setProperty(KEY_SCALE_X, presentation.geometry.savedScaleX.toString())
            properties.setProperty(KEY_SCALE_Y, presentation.geometry.savedScaleY.toString())
            val safeScale = if (isValidStickyFontScale(presentation.fontScale)) presentation.fontScale else DEFAULT_STICKY_FONT_SCALE
            properties.setProperty(KEY_FONT_SCALE, safeScale.toString())
            FileOutputStream(tempFile).use { fos ->
                properties.store(fos, "TabbyRush Sticky Window Presentation Preferences")
                fos.fd.sync()
            }

            try {
                Files.move(
                    tempFile.toPath(),
                    file.toPath(),
                    StandardCopyOption.ATOMIC_MOVE,
                    StandardCopyOption.REPLACE_EXISTING
                )
            } catch (_: AtomicMoveNotSupportedException) {
                Files.move(
                    tempFile.toPath(),
                    file.toPath(),
                    StandardCopyOption.REPLACE_EXISTING
                )
            }
        } catch (_: Exception) {
            // Best effort presentation persistence; prevent runtime crashes on disk/permission failure
        } finally {
            if (tempFile.exists()) {
                tempFile.delete()
            }
        }
    }
}
