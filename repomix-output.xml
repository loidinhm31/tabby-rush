                    "hasMore":false
                }"""
            )
        }

        val (client, store) = createTestSetup(engine)
        // Local base has revision 2 from v1 (null temporal fields)
        store.dao.upsertServerBase(
            ServerBaseEntity(
                rowId = "row-eq-rev",
                serverRevision = 2L,
                deleted = false,
                title = "Identical Title",
