                                Spacer(modifier = Modifier.height(12.dp))
                                Button(
                                    onClick = onRequestPermission,
                                    modifier = Modifier.align(Alignment.End)
                                ) {
                                    Text(text = stringResource(R.string.task_surface_btn_grant_permission))
