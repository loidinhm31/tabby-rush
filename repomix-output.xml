            // 8. Rebuild account_sync_meta
            connection.execSQL(
                "CREATE TABLE `account_sync_meta_v5` (" +
                    "`id` TEXT NOT NULL, " +
                    "`lastSyncTime` INTEGER, " +
                    "`localRevisionCounter` INTEGER NOT NULL, " +
                    "`syncStatus` TEXT NOT NULL, " +
                    "`safeErrorCode` TEXT, " +
