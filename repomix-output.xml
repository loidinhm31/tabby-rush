package dev.tabbyrush.desktop.windows

import com.sun.jna.Platform
import com.sun.jna.platform.win32.Crypt32Util
import com.sun.jna.platform.win32.WinCrypt
import dev.tabbyrush.desktop.CredentialVaultProvider
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.CredentialBundle
import dev.tabbyrush.shared.contract.CredentialVault
import dev.tabbyrush.shared.contract.VaultStatus
import dev.tabbyrush.shared.data.JvmAccountFiles
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json
import java.io.File
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import java.nio.file.attribute.AclEntry
import java.nio.file.attribute.AclEntryPermission
import java.nio.file.attribute.AclEntryType
import java.nio.file.attribute.AclFileAttributeView

@Serializable
internal data class StoredCredentialPayload(
    val accountKey: String,
    val accessToken: String,
    val refreshToken: String
)

/**
 * Interface abstracting Windows DPAPI data protection operations for testability.
 */
interface WindowsDpapiProtector {
    fun isAvailable(): Boolean
    fun protect(plainBytes: ByteArray): ByteArray
    fun unprotect(cipherBytes: ByteArray): ByteArray
}

/**
 * Default Windows DPAPI protector using JNA Crypt32Util.
 * Invariants:
 * - Scope: Always current user scope (CRYPTPROTECT_LOCAL_MACHINE is NEVER used).
 * - UI Forbidden: CRYPTPROTECT_UI_FORBIDDEN flag set to prevent interactive prompts.
 * - Fails closed: CryptUnprotectData failure throws Win32Exception.
 */
class JnaWindowsDpapiProtector : WindowsDpapiProtector {
    override fun isAvailable(): Boolean {
        return Platform.isWindows()
    }

    override fun protect(plainBytes: ByteArray): ByteArray {
        if (!isAvailable()) {
            throw IllegalStateException("Windows DPAPI is only available on Windows operating systems")
        }
        return Crypt32Util.cryptProtectData(plainBytes, WinCrypt.CRYPTPROTECT_UI_FORBIDDEN)
    }

    override fun unprotect(cipherBytes: ByteArray): ByteArray {
        if (!isAvailable()) {
            throw IllegalStateException("Windows DPAPI is only available on Windows operating systems")
        }
        return Crypt32Util.cryptUnprotectData(cipherBytes, WinCrypt.CRYPTPROTECT_UI_FORBIDDEN)
    }
}

/**
 * WindowsDpapiVault implements hardware/OS-backed credential custody on Windows via DPAPI (Data Protection API).
 *
 * Invariants:
 * 1. Tokens are serialized together with the account key as a single atomic credential bundle to prevent partial updates.
 * 2. User-Scoped DPAPI: DPAPI key derivation is bound to the current Windows user login credentials.
 * 3. Atomic Replacement: Bundles are written to a temp file, user ACL is enforced, and atomically moved into place.
 * 4. Fail-Closed: Never falls back to plaintext storage or machine-wide encryption.
 * 5. Memory Hygiene: Native and JVM byte arrays holding plaintext tokens are zeroed out after use.
 * 6. Status Transitions: Corrupt files or unprotect failures transition status to CORRUPT and preserve local databases.
 */
class WindowsDpapiVault(
    private val accountFiles: JvmAccountFiles,
    private val protector: WindowsDpapiProtector = JnaWindowsDpapiProtector()
) : CredentialVault {

    private val json = Json { ignoreUnknownKeys = true }
    private var internalStatus: VaultStatus = if (protector.isAvailable()) VaultStatus.READY else VaultStatus.UNAVAILABLE

    override val status: VaultStatus
        get() = internalStatus

    fun getVaultFile(accountKey: AccountKey): File {
        val dir = accountFiles.getAccountDirectory(accountKey)
        return File(dir, VAULT_FILE_NAME)
    }

    override suspend fun load(accountKey: AccountKey): CredentialBundle? = withContext(Dispatchers.IO) {
        if (!protector.isAvailable()) {
            internalStatus = VaultStatus.UNAVAILABLE
            throw IllegalStateException("Windows DPAPI provider is unavailable on this host")
        }

        val vaultFile = getVaultFile(accountKey)
        if (!vaultFile.exists() || vaultFile.length() == 0L) {
            return@withContext null
        }

        val cipherBytes = try {
            vaultFile.readBytes()
        } catch (e: Exception) {
            internalStatus = VaultStatus.CORRUPT
            throw IllegalStateException("Failed to read DPAPI vault file for account: ${accountKey.value}", e)
        }

        val plainBytes = try {
            protector.unprotect(cipherBytes)
        } catch (e: Exception) {
            internalStatus = VaultStatus.CORRUPT
            throw IllegalStateException("Failed to unprotect DPAPI credential bundle for account: ${accountKey.value}", e)
        }

        try {
            val rawJson = plainBytes.toString(Charsets.UTF_8)
            val payload = json.decodeFromString<StoredCredentialPayload>(rawJson)

            if (payload.accountKey.isNotBlank() && payload.accountKey != accountKey.value) {
                internalStatus = VaultStatus.CORRUPT
                throw IllegalStateException(
                    "Account key mismatch in DPAPI bundle: expected '${accountKey.value}', found '${payload.accountKey}'"
                )
            }

            internalStatus = VaultStatus.READY
            CredentialBundle(accessToken = payload.accessToken, refreshToken = payload.refreshToken)
        } catch (e: Exception) {
            internalStatus = VaultStatus.CORRUPT
            if (e is IllegalStateException) throw e
            throw IllegalStateException("Corrupt DPAPI credential payload for account: ${accountKey.value}", e)
        } finally {
            plainBytes.fill(0)
        }
    }

    override suspend fun store(accountKey: AccountKey, bundle: CredentialBundle): Unit = withContext(Dispatchers.IO) {
        if (!protector.isAvailable()) {
            internalStatus = VaultStatus.UNAVAILABLE
            throw IllegalStateException("Windows DPAPI provider is unavailable on this host")
        }

        val dir = accountFiles.getAccountDirectory(accountKey)
        if (!dir.exists()) {
            dir.mkdirs()
        }

        val payload = StoredCredentialPayload(
            accountKey = accountKey.value,
            accessToken = bundle.accessToken,
            refreshToken = bundle.refreshToken
        )
        val rawJson = json.encodeToString(StoredCredentialPayload.serializer(), payload)
        val plainBytes = rawJson.toByteArray(Charsets.UTF_8)

        val cipherBytes = try {
            protector.protect(plainBytes)
        } finally {
            plainBytes.fill(0)
        }

        val vaultFile = File(dir, VAULT_FILE_NAME)
        val tempFile = File(dir, "$VAULT_FILE_NAME.tmp")

        try {
            tempFile.writeBytes(cipherBytes)
            applyRestrictiveUserAcl(tempFile)
            Files.move(
                tempFile.toPath(),
                vaultFile.toPath(),
                StandardCopyOption.ATOMIC_MOVE,
                StandardCopyOption.REPLACE_EXISTING
            )
            internalStatus = VaultStatus.READY
        } catch (e: Exception) {
            if (tempFile.exists()) {
                tempFile.delete()
            }
            throw IllegalStateException("Failed to atomically write DPAPI vault file for account: ${accountKey.value}", e)
        }
    }

    override suspend fun clear(accountKey: AccountKey): Unit = withContext(Dispatchers.IO) {
        val dir = accountFiles.getAccountDirectory(accountKey)
        val vaultFile = File(dir, VAULT_FILE_NAME)
        val tempFile = File(dir, "$VAULT_FILE_NAME.tmp")

        if (tempFile.exists()) {
            Files.deleteIfExists(tempFile.toPath())
        }
        if (vaultFile.exists()) {
            Files.deleteIfExists(vaultFile.toPath())
        }
        internalStatus = if (protector.isAvailable()) VaultStatus.READY else VaultStatus.UNAVAILABLE
    }

    private fun applyRestrictiveUserAcl(file: File) {
        val path = file.toPath()
        val isAclSupported = path.fileSystem.supportedFileAttributeViews().contains("acl")
        if (isAclSupported) {
            val aclView = Files.getFileAttributeView(path, AclFileAttributeView::class.java)
                ?: throw IllegalStateException("AclFileAttributeView unavailable on ACL-supporting filesystem for: ${file.name}")
            val owner = aclView.owner
                ?: throw IllegalStateException("Unable to resolve owner principal for: ${file.name}")
            val userEntry = AclEntry.newBuilder()
                .setType(AclEntryType.ALLOW)
                .setPrincipal(owner)
                .setPermissions(
                    AclEntryPermission.READ_DATA,
                    AclEntryPermission.WRITE_DATA,
                    AclEntryPermission.APPEND_DATA,
                    AclEntryPermission.READ_NAMED_ATTRS,
                    AclEntryPermission.WRITE_NAMED_ATTRS,
                    AclEntryPermission.EXECUTE,
                    AclEntryPermission.DELETE_CHILD,
                    AclEntryPermission.READ_ATTRIBUTES,
                    AclEntryPermission.WRITE_ATTRIBUTES,
                    AclEntryPermission.DELETE,
                    AclEntryPermission.READ_ACL,
                    AclEntryPermission.WRITE_ACL,
                    AclEntryPermission.WRITE_OWNER,
                    AclEntryPermission.SYNCHRONIZE
                )
                .build()
            try {
                aclView.acl = listOf(userEntry)
            } catch (e: Exception) {
                throw IllegalStateException("Failed to apply restrictive user ACL on: ${file.name}", e)
            }
        } else if (Platform.isWindows()) {
            throw IllegalStateException("ACL file attribute view is required on Windows for: ${file.name}")
        }
    }

    companion object {
        const val VAULT_FILE_NAME = "credentials.dpapi"
    }
}

/**
 * Service Provider Interface implementation for Windows DPAPI vault.
 */
class WindowsDpapiVaultProvider : CredentialVaultProvider {
    override val target: String = "windows"

    override fun createVault(accountFiles: JvmAccountFiles): CredentialVault {
        return WindowsDpapiVault(accountFiles)
    }
}
</file>

<file path="desktopApp/src/windowsMain/kotlin/dev/tabbyrush/desktop/windows/windows-notification-adapter.kt">
package dev.tabbyrush.desktop.windows

import dev.tabbyrush.desktop.DesktopReminderAdapter
import dev.tabbyrush.desktop.DesktopReminderAdapterProvider
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.NativeReminderAdapter
import dev.tabbyrush.shared.contract.ReminderCapabilities
import dev.tabbyrush.shared.contract.ScheduledAlarmHandle
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.util.concurrent.ConcurrentHashMap

/**
 * Result status for Windows toast notification actions.
 */
sealed interface WindowsNotificationStatus {
    data class Success(val tag: String, val group: String) : WindowsNotificationStatus
    data class Cleared(val tag: String, val group: String) : WindowsNotificationStatus
    data class Unavailable(val reason: String) : WindowsNotificationStatus
    data class Error(val message: String) : WindowsNotificationStatus
}

/**
 * Windows notification adapter managing AUMID toast presentation and history removal.
 */
class WindowsNotificationAdapter(
    private val bridge: WindowsToastBridge = JnaWindowsToastBridge()
) {
    companion object {
        const val AUMID = "dev.tabbyrush.desktop"
        const val DEFAULT_GROUP = "tabbyrush_reminders"

        fun escapeXml(text: String): String {
            return text
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;")
                .replace("'", "&apos;")
        }

        fun buildToastXml(title: String, message: String): String {
            val safeTitle = escapeXml(title)
            val safeMessage = escapeXml(message)
            return """<toast><visual><binding template="ToastGeneric"><text>$safeTitle</text><text>$safeMessage</text></binding></visual><audio src="ms-winsoundevent:Notification.Default"/></toast>"""
        }
    }

    fun isAvailable(): Boolean = bridge.isAvailable()
    fun querySetting(): WindowsNotificationSetting = bridge.querySetting(AUMID)

    fun postNotification(
        tag: String,
        title: String,
        message: String,
        group: String = DEFAULT_GROUP
    ): WindowsNotificationStatus {
        val xml = buildToastXml(title, message)
        return bridge.showToast(AUMID, xml, tag, group)
    }

    fun cancelNotification(
        tag: String,
        group: String = DEFAULT_GROUP
    ): WindowsNotificationStatus {
        return bridge.clearToast(AUMID, tag, group)
    }

    fun cancelGroup(group: String): WindowsNotificationStatus {
        return bridge.clearGroup(AUMID, group)
    }

    fun cancelAllNotifications(): WindowsNotificationStatus {
        return bridge.clearAllToasts(AUMID)
    }
}

/**
 * Windows desktop native reminder adapter bridging shared NativeReminderAdapter to
 * the Windows Toast notification system.
 * Dispatches IPC/COM operations on Dispatchers.IO to prevent blocking the UI/Swing thread.
 */
class WindowsNativeReminderAdapter(
    val windowsAdapter: WindowsNotificationAdapter = WindowsNotificationAdapter(),
    private val ioDispatcher: CoroutineDispatcher = Dispatchers.IO
) : DesktopReminderAdapter {

    private val postedPlatformIds = ConcurrentHashMap<String, MutableSet<String>>()
    private var scheduleListener: ((AccountKey, Long, List<ScheduledAlarmHandle>) -> Unit)? = null

    override fun setScheduleListener(listener: ((AccountKey, Long, List<ScheduledAlarmHandle>) -> Unit)?) {
        scheduleListener = listener
    }

    override suspend fun queryCapabilities(): ReminderCapabilities = withContext(ioDispatcher) {
        val available = windowsAdapter.isAvailable()
        val setting = windowsAdapter.querySetting()
        val isEnabled = available && (setting == WindowsNotificationSetting.ENABLED)
        ReminderCapabilities(
            canScheduleExactAlarms = true,
            canPostNotifications = available,
            areNotificationsEnabled = isEnabled
        )
    }

    override suspend fun reconcileSchedule(
        accountKey: AccountKey,
        generation: Long,
        desiredAlarms: List<ScheduledAlarmHandle>
    ) {
        scheduleListener?.invoke(accountKey, generation, desiredAlarms)
    }

    override suspend fun postOwnedNotification(
        accountKey: AccountKey,
        generation: Long,
        taskId: String,
        scheduleToken: String,
        occurrenceIndex: Int,
        title: String,
        dueEpochMs: Long
    ): String? = withContext(ioDispatcher) {
        val tag = "t_${taskId.take(16)}_$occurrenceIndex"
        val group = "d_${accountKey.value.take(12)}"
        val safeTitle = title.ifBlank { "Task Reminder" }
        val status = windowsAdapter.postNotification(
            tag = tag,
            title = safeTitle,
            message = "Task reminder is due",
            group = group
        )
        when (status) {
            is WindowsNotificationStatus.Success -> {
                val platformId = "$group|$tag"
                postedPlatformIds.computeIfAbsent(accountKey.value) { ConcurrentHashMap.newKeySet() }.add(platformId)
                platformId
            }
            else -> null
        }
    }

    override suspend fun removeOwnedNotification(
        accountKey: AccountKey,
        platformNotificationId: String
    ) = withContext(ioDispatcher) {
        val accountIds = postedPlatformIds[accountKey.value]
        if (accountIds?.contains(platformNotificationId) == true) {
            val parts = platformNotificationId.split('|')
            if (parts.size == 2) {
                val group = parts[0]
                val tag = parts[1]
                windowsAdapter.cancelNotification(tag = tag, group = group)
                accountIds.remove(platformNotificationId)
            }
        }
    }

    override suspend fun cancelAllForAccount(accountKey: AccountKey) = withContext(ioDispatcher) {
        val accountIds = postedPlatformIds.remove(accountKey.value) ?: mutableSetOf()
        val group = "d_${accountKey.value.take(12)}"
        val errors = mutableListOf<String>()
        for (platformId in accountIds) {
            val parts = platformId.split('|')
            if (parts.size == 2) {
                try {
                    val status = windowsAdapter.cancelNotification(tag = parts[1], group = parts[0])
                    if (status is WindowsNotificationStatus.Error) {
                        errors.add("Failed to clear toast $platformId: ${status.message}")
                    }
                } catch (e: Exception) {
                    errors.add("Exception clearing toast $platformId: ${e.message}")
                }
            }
        }
        try {
            val groupStatus = windowsAdapter.cancelGroup(group)
            if (groupStatus is WindowsNotificationStatus.Error) {
                errors.add("Failed to clear group $group: ${groupStatus.message}")
            }
        } catch (e: Exception) {
            errors.add("Exception clearing group $group: ${e.message}")
        }
        if (errors.isNotEmpty()) {
            throw IllegalStateException("Failed to cancel Windows notifications for ${accountKey.value}: ${errors.joinToString("; ")}")
        }
    }
}

/**
 * ServiceLoader provider for Windows desktop reminder adapter.
 */
class WindowsReminderAdapterProvider : DesktopReminderAdapterProvider {
    override val target: String = "windows"
    override fun createAdapter(): NativeReminderAdapter = WindowsNativeReminderAdapter()
}
