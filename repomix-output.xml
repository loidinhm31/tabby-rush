#!/usr/bin/env bash
set -euo pipefail

# TabbyRush Linux Desktop & RPM Package Verification Smoke Runner
# Phase 09 Validation & Diagnostics Harness

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

RPM_FILE=""
DIST_DIR=""
MODE="validate"

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  --rpm <file>       Path to built RPM package (.rpm)
  --dist <dir>       Path to createDistributable application directory
  --diagnose         Diagnose host environment (rpm, rpm-build, D-Bus, secret-tool)
  --help             Show this help message

Examples:
  $0 --diagnose
  $0 --rpm desktopApp/build/compose/binaries/main/rpm/tabbyrush-1.0.0.rpm
  $0 --dist desktopApp/build/compose/binaries/main/app/tabbyrush
EOF
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --rpm)
            RPM_FILE="$2"
            shift 2
            ;;
        --dist)
            DIST_DIR="$2"
            shift 2
            ;;
        --diagnose)
            MODE="diagnose"
            shift
            ;;
        --help)
            usage
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

if [[ "$MODE" == "diagnose" ]]; then
    echo "=== TabbyRush Linux Desktop Environment Diagnostics ==="
    echo "1. Host OS: $(uname -s) $(uname -r) ($(uname -m))"

    echo -n "2. Java Runtime: "
    if command -v java >/dev/null 2>&1; then
        java -version 2>&1 | head -n 1
    else
        echo "NOT FOUND in PATH"
    fi

    echo -n "3. jpackage tool: "
    if command -v jpackage >/dev/null 2>&1; then
        jpackage --version 2>&1
    elif [[ -x "${JAVA_HOME:-}/bin/jpackage" ]]; then
        "${JAVA_HOME}/bin/jpackage" --version 2>&1
    else
        echo "NOT FOUND"
    fi

    echo -n "4. RPM query tool (rpm): "
    if command -v rpm >/dev/null 2>&1; then
        rpm --version
    else
        echo "MISSING"
    fi

    echo -n "5. RPM build tool (rpmbuild): "
    if command -v rpmbuild >/dev/null 2>&1; then
        rpmbuild --version
    else
        echo "NOT INSTALLED (Required for :desktopApp:packageRpm; install via 'sudo dnf install -y rpm-build')"
    fi

    echo -n "6. Secret Service CLI (secret-tool): "
    if command -v secret-tool >/dev/null 2>&1; then
        echo "PRESENT ($(which secret-tool))"
    else
        echo "NOT FOUND (Install via 'sudo dnf install -y libsecret')"
    fi

    echo -n "7. D-Bus session bus: "
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        echo "CONNECTED ($DBUS_SESSION_BUS_ADDRESS)"
    else
        echo "NOT CONNECTED (Headless / non-GUI session; run inside Xpra or desktop terminal)"
    fi

    echo -n "8. X11 / Wayland Display: "
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        echo "PRESENT (DISPLAY=${DISPLAY:-none}, WAYLAND=${WAYLAND_DISPLAY:-none})"
    else
        echo "NOT SET (Use Xpra display :100 or native desktop display)"
    fi

    echo "=== Diagnostics Complete ==="
    exit 0
fi

if [[ -n "$DIST_DIR" ]]; then
    echo "=== Verifying Unpacked Linux Distributable ==="
    if [[ ! -d "$DIST_DIR" ]]; then
        echo "ERROR: Distributable directory does not exist: $DIST_DIR" >&2
        exit 1
    fi

    LAUNCHER="$DIST_DIR/bin/tabbyrush"
    if [[ ! -x "$LAUNCHER" ]]; then
        LAUNCHER="$DIST_DIR/bin/TabbyRush"
    fi
    if [[ ! -x "$LAUNCHER" ]]; then
        echo "ERROR: TabbyRush executable launcher not found in $DIST_DIR/bin" >&2
        exit 1
    fi
    echo "✓ Found executable launcher: $LAUNCHER"

    RUNTIME_JAVA="$DIST_DIR/runtime/bin/java"
    if [[ -x "$RUNTIME_JAVA" ]]; then
        echo -n "✓ Bundled self-contained JRE: "
        "$RUNTIME_JAVA" -version 2>&1 | head -n 1
    else
        echo "WARNING: Bundled runtime binary not found at $RUNTIME_JAVA"
    fi

    # Check packaged jar for Linux provider and absence of Windows classes
    echo "Checking packaged application jars..."
    APP_JARS=$(find "$DIST_DIR/lib" -name "*.jar" 2>/dev/null || true)
    FOUND_LINUX_PROVIDER=false
    FOUND_WINDOWS_PROVIDER=false

    for jar in $APP_JARS; do
        if unzip -l "$jar" 2>/dev/null | grep -q "dev/tabbyrush/desktop/linux/LinuxSecretServiceVaultProvider.class"; then
            FOUND_LINUX_PROVIDER=true
        fi
        if unzip -l "$jar" 2>/dev/null | grep -q "WindowsDpapiVaultProvider"; then
            FOUND_WINDOWS_PROVIDER=true
        fi
    done

    if [[ "$FOUND_LINUX_PROVIDER" == "true" ]]; then
        echo "✓ Packaged LinuxSecretServiceVaultProvider detected"
    else
        echo "WARNING: LinuxSecretServiceVaultProvider not found in packaged jars"
    fi

    if [[ "$FOUND_WINDOWS_PROVIDER" == "true" ]]; then
        echo "ERROR: Forbidden WindowsDpapiVaultProvider detected in Linux distribution!" >&2
        exit 1
    else
        echo "✓ No Windows provider classes packaged in Linux bundle"
    fi

    echo "=== Distributable Verification Passed ==="
    exit 0
fi

if [[ -n "$RPM_FILE" ]]; then
    echo "=== Verifying RPM Package: $RPM_FILE ==="
    if [[ ! -f "$RPM_FILE" ]]; then
        echo "ERROR: RPM file does not exist: $RPM_FILE" >&2
        exit 1
    fi

    # Check SHA-256
    SHA256=$(sha256sum "$RPM_FILE" | awk '{print $1}')
    SIZE_BYTES=$(stat -c "%s" "$RPM_FILE" 2>/dev/null || stat -f "%z" "$RPM_FILE")
    echo "File: $(basename "$RPM_FILE")"
    echo "Size: $SIZE_BYTES bytes"
    echo "SHA-256: $SHA256"

    # Query RPM Metadata
    echo "--- RPM Package Info (rpm -qpi) ---"
    rpm -qpi "$RPM_FILE"

    echo "--- RPM Package Contents Summary (rpm -qlp) ---"
    FILE_COUNT=$(rpm -qlp "$RPM_FILE" | wc -l)
    echo "Total files packaged: $FILE_COUNT"

    # Verify key paths
    if rpm -qlp "$RPM_FILE" | grep -q "/bin/tabbyrush"; then
        echo "✓ RPM packages executable launcher: /bin/tabbyrush"
    else
        echo "WARNING: /bin/tabbyrush not found in RPM file list"
    fi

    if rpm -qlp "$RPM_FILE" | grep -q "/share/applications/.*\.desktop"; then
        echo "✓ RPM packages desktop entry file"
    fi

    # Check for any forbidden Windows artifacts
    if rpm -qlp "$RPM_FILE" | grep -iE '\.dll$|\.exe$|windows'; then
        echo "ERROR: Forbidden Windows binaries/paths detected in Linux RPM!" >&2
        exit 1
    else
        echo "✓ Clean Linux RPM: Zero Windows DLLs or executables"
    fi

    echo "=== RPM Package Verification Complete ==="
    exit 0
fi

echo "ERROR: Either --rpm, --dist, or --diagnose must be specified." >&2
usage
</file>

<file path="scripts/start-android-emulator.sh">
#!/usr/bin/env bash
# scripts/start-android-emulator.sh - Launch Android Emulator for TabbyRush
# Complies with Phase 01: checks KVM, selects GPU mode, binds emulator-5554
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source Android SDK environment if emulator is missing from PATH
if ! command -v emulator >/dev/null 2>&1; then
  if [[ -f "${SCRIPT_DIR}/android-sdk-env.sh" ]]; then
    # shellcheck source=scripts/android-sdk-env.sh
    source "${SCRIPT_DIR}/android-sdk-env.sh"
  fi
fi

AVD_NAME="${1:-tabbyrush_android}"
PORT="${EMULATOR_PORT:-5554}"
GPU_MODE="${EMULATOR_GPU:-auto}"
XPRA_DISPLAY_TARGET="${XPRA_DISPLAY:-:100}"
EXTRA_ARGS=()

check_prerequisites() {
  # 1. Validate port (decimal integer without leading zeros, even number between 5554 and 5682)
  if ! [[ "${PORT}" =~ ^[1-9][0-9]{3,4}$ ]]; then
    echo "Error: Invalid EMULATOR_PORT '${PORT}'. Must be an even number between 5554 and 5682." >&2
    exit 1
  fi
  PORT=$((10#${PORT}))
  if [ "$((PORT % 2))" -ne 0 ] || [ "${PORT}" -lt 5554 ] || [ "${PORT}" -gt 5682 ]; then
    echo "Error: Invalid EMULATOR_PORT '${PORT}'. Must be an even number between 5554 and 5682." >&2
    exit 1
  fi

  # 2. Check emulator binary
  if ! command -v emulator >/dev/null 2>&1; then
    echo "Error: 'emulator' command not found." >&2
    echo "Ensure Android SDK emulator package is installed and PATH is configured." >&2
    echo "Run: source ${SCRIPT_DIR}/android-sdk-env.sh" >&2
    exit 1
  fi

  # 3. Check KVM hardware virtualization
  if [[ ! -e /dev/kvm ]]; then
    echo "Warning: /dev/kvm not found. Virtualization acceleration unavailable." >&2
  elif [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    echo "Warning: /dev/kvm lacks read/write permissions for user $(whoami)." >&2
  else
    echo "KVM acceleration: /dev/kvm accessible (OK)"
  fi

  # 4. Accel check
  echo "Checking emulator hardware acceleration..."
  emulator -accel-check || true

  # 5. Check DISPLAY if running with GUI window
  if [[ -z "${DISPLAY:-}" ]]; then
    echo "Notice: DISPLAY environment variable is unset."
    if command -v xpra >/dev/null 2>&1 && xpra list 2>/dev/null | grep -E "(^|[[:space:]/])${XPRA_DISPLAY_TARGET}([[:space:]]|$)" >/dev/null 2>&1; then
      echo "Detected running Xpra on ${XPRA_DISPLAY_TARGET}. Setting DISPLAY=${XPRA_DISPLAY_TARGET}"
      export DISPLAY="${XPRA_DISPLAY_TARGET}"
    else
      echo "Warning: No graphical DISPLAY found. For headless CI, set EMULATOR_HEADLESS=1"
    fi
  fi
}

check_prerequisites

if [[ "${EMULATOR_HEADLESS:-0}" == "1" ]]; then
  EXTRA_ARGS+=("-no-window" "-no-audio")
fi

echo "Starting emulator '${AVD_NAME}' on port ${PORT} with GPU mode '${GPU_MODE}'..."
echo "To attach or monitor boot:"
echo "  adb -s emulator-${PORT} wait-for-device"
echo "  adb -s emulator-${PORT} shell getprop sys.boot_completed"

# Launch emulator
exec emulator \
  -avd "${AVD_NAME}" \
  -port "${PORT}" \
  -gpu "${GPU_MODE}" \
  "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
</file>

<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/auth/hub-auth-session.kt">
package dev.tabbyrush.shared.auth

import dev.tabbyrush.shared.contract.AccessRequestInfo
import dev.tabbyrush.shared.contract.AccountIdentity
import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.ApiResult
import dev.tabbyrush.shared.contract.AuthState
import dev.tabbyrush.shared.contract.AuthSession
import dev.tabbyrush.shared.contract.CredentialBundle
import dev.tabbyrush.shared.contract.CredentialVault
import dev.tabbyrush.shared.contract.HubConfig
import dev.tabbyrush.shared.contract.SafeError
import dev.tabbyrush.shared.contract.VaultStatus
import dev.tabbyrush.shared.contract.UserLookupResult
import io.ktor.client.engine.HttpClientEngine
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock

/**
 * HubAuthSession manages the lifecycle, in-memory tokens, and state transitions
 * for a Glean Hub authenticated account session.
 *
 * Implements strict security boundaries:
 * - Opaque credentials exist ONLY in memory and the injected CredentialVault.
 * - State flow exposes only AuthState, AccountIdentity, and AccountKey (NEVER tokens or secrets).
 * - Single-flight token refresh across foreground/background with generation fencing.
 * - Credential persistence coordinated under session mutex to eliminate logout races.
 * - Prohibits automatic POST replays in 401 recovery loops (coordinator controls sync retries).
 * - Local logout deletes vault bundle only; acknowledges remote tokens remain valid until expiry.
 */
class HubAuthSession(
    val config: HubConfig,
    val vault: CredentialVault,
    engine: HttpClientEngine? = null,
    private val onCredentialPersistenceFailed: suspend (AccountKey, CredentialBundle, Exception) -> Unit = { _, _, _ -> }
) : AuthSession {

    val authClient = HubAuthClient(config, engine)

    private val sessionMutex = Mutex()

    private val _state = MutableStateFlow(AuthState.UNAUTHENTICATED)
    override val state: StateFlow<AuthState> = _state.asStateFlow()

    private val _currentIdentity = MutableStateFlow<AccountIdentity?>(null)
    override val currentIdentity: StateFlow<AccountIdentity?> = _currentIdentity.asStateFlow()

    private val _currentAccountKey = MutableStateFlow<AccountKey?>(null)
    override val currentAccountKey: StateFlow<AccountKey?> = _currentAccountKey.asStateFlow()

    // Opaque in-memory token bundle; never logged or exposed in state flows
    private var inMemoryBundle: CredentialBundle? = null

    // Generation counter increments on quiesce/logout/switch to fence stale async completions
    private var currentGeneration: Long = 0L

    private val refreshCoordinator = SingleFlightRefreshCoordinator()

    /**
     * Attempts to restore an established offline session from the vault without requiring network connectivity.
     */
    suspend fun restoreSession(identity: AccountIdentity, key: AccountKey): Boolean = sessionMutex.withLock {
        if (vault.status != VaultStatus.READY) {
            return false
        }
        val expectedKey = AccountKey.create(config.canonicalOrigin, identity.userId)
        if (key != expectedKey) {
            return false
        }
        val bundle = vault.load(key) ?: return false
        inMemoryBundle = bundle
        _currentIdentity.value = identity
        _currentAccountKey.value = key
        _state.value = AuthState.AUTHENTICATED
        return true
    }

    override suspend fun register(
        username: String,
        email: String,
        password: String
    ): ApiResult<AccountIdentity> {
        val gen = sessionMutex.withLock {
            _state.value = AuthState.AUTHENTICATING
            ++currentGeneration
        }

        val regResult = authClient.register(username, email, password)
        when (regResult) {
            is ApiResult.Failure -> {
                sessionMutex.withLock {
                    if (currentGeneration == gen) {
                        _state.value = AuthState.UNAUTHENTICATED
                        inMemoryBundle = null
                        _currentIdentity.value = null
                        _currentAccountKey.value = null
                    }
                }
                return regResult
            }
            is ApiResult.Success -> {
                val regResponse = regResult.value
                val bundle = regResponse.toCredentialBundle()
                return completeLoginWithMe(regResponse.userId, bundle, gen)
            }
        }
    }

    override suspend fun login(
        email: String,
        password: String
    ): ApiResult<AccountIdentity> {
        val gen = sessionMutex.withLock {
            _state.value = AuthState.AUTHENTICATING
            ++currentGeneration
        }

        val loginResult = authClient.login(email, password)
        when (loginResult) {
            is ApiResult.Failure -> {
                sessionMutex.withLock {
                    if (currentGeneration == gen) {
                        _state.value = AuthState.UNAUTHENTICATED
                        inMemoryBundle = null
                        _currentIdentity.value = null
                        _currentAccountKey.value = null
                    }
                }
                return loginResult
            }
            is ApiResult.Success -> {
                val loginResponse = loginResult.value
                val bundle = loginResponse.toCredentialBundle()
                return completeLoginWithMe(loginResponse.userId, bundle, gen)
            }
        }
    }

    private suspend fun completeLoginWithMe(
        expectedUserId: String,
        bundle: CredentialBundle,
        gen: Long
    ): ApiResult<AccountIdentity> {
        val meResult = authClient.getMe(bundle.accessToken)
        when (meResult) {
            is ApiResult.Failure -> {
                sessionMutex.withLock {
                    if (currentGeneration == gen) {
                        _state.value = AuthState.UNAUTHENTICATED
                        inMemoryBundle = null
                        _currentIdentity.value = null
                        _currentAccountKey.value = null
                    }
                }
                return meResult
            }
            is ApiResult.Success -> {
                val me = meResult.value
                if (me.userId != expectedUserId) {
                    sessionMutex.withLock {
                        if (currentGeneration == gen) {
                            _state.value = AuthState.UNAUTHENTICATED
                            inMemoryBundle = null
                            _currentIdentity.value = null
                            _currentAccountKey.value = null
                        }
                    }
                    return ApiResult.Failure(
                        SafeError.Unauthorized(
                            code = "USER_ID_MISMATCH",
                            message = "Authenticated user ID '${me.userId}' did not match login response '$expectedUserId'"
                        )
                    )
                }

                val identity = me.toAccountIdentity()
                val accountKey = AccountKey.create(config.canonicalOrigin, me.userId)

                var persistenceError: Exception? = null
                sessionMutex.withLock {
                    if (currentGeneration != gen) {
                        return ApiResult.Failure(
                            SafeError.Unauthorized(
                                code = "SESSION_INTERRUPTED",
                                message = "Session generation changed during authentication sequence"
                            )
                        )
                    }

                    try {
                        vault.store(accountKey, bundle)
                    } catch (vaultEx: Exception) {
                        persistenceError = vaultEx
                    }

                    if (persistenceError != null) {
                        _state.value = AuthState.UNAUTHENTICATED
                        inMemoryBundle = null
                        _currentIdentity.value = null
                        _currentAccountKey.value = null
                    } else {
                        inMemoryBundle = bundle
                        _currentIdentity.value = identity
                        _currentAccountKey.value = accountKey

                        if (me.hasTabbyRushAccess(config.appId)) {
                            _state.value = AuthState.AUTHENTICATED
                        } else {
                            _state.value = AuthState.ACCESS_PENDING
                        }
                    }
                }

                persistenceError?.let { vaultEx ->
                    onCredentialPersistenceFailed(accountKey, bundle, vaultEx)
                    return ApiResult.Failure(
                        SafeError.Internal(
                            code = "VAULT_WRITE_FAILED",
                            message = "Failed to securely store credentials in vault"
                        )
                    )
                }

                return ApiResult.Success(identity)
            }
        }
    }

    override suspend fun refresh(): ApiResult<Unit> {
        val (key, bundle, gen) = sessionMutex.withLock {
            val k = _currentAccountKey.value
            val b = inMemoryBundle
            val g = currentGeneration
            if (k == null || b == null) {
                return ApiResult.Failure(
                    SafeError.Unauthorized(
                        code = "NO_SESSION_TO_REFRESH",
                        message = "No active session credentials to refresh"
                    )
                )
            }
            Triple(k, b, g)
        }

        val refreshResult = refreshCoordinator.refresh {
            when (val res = authClient.refresh(bundle.refreshToken)) {
                is ApiResult.Success -> ApiResult.Success(res.value.toCredentialBundle())
                is ApiResult.Failure -> res
            }
        }

        var persistenceError: Exception? = null
        val finalResult: ApiResult<Unit> = sessionMutex.withLock {
            // Generation fence: ensure generation has not changed (e.g. logout)
            if (currentGeneration != gen) {
                return@withLock ApiResult.Failure(
                    SafeError.Unauthorized(
                        code = "GENERATION_STALE",
                        message = "Session generation changed during token refresh; discarded successor"
                    )
                )
            }

            when (refreshResult) {
                is ApiResult.Failure -> {
                    // Conservative reauth per contracts §3: any refresh failure forces reauth
                    _state.value = AuthState.REAUTH_REQUIRED
                    ApiResult.Failure(refreshResult.error)
                }
                is ApiResult.Success -> {
                    val successor = refreshResult.value
                    // Always update in-memory bundle with the successor to avoid using consumed predecessor
                    inMemoryBundle = successor

                    try {
                        vault.store(key, successor)
                    } catch (vaultEx: Exception) {
                        persistenceError = vaultEx
                    }

                    if (persistenceError != null) {
                        ApiResult.Failure(
                            SafeError.Internal(
                                code = "CREDENTIAL_PERSISTENCE_FAILED",
                                message = "Token refreshed on server but local vault persistence failed"
                            )
                        )
                    } else {
                        ApiResult.Success(Unit)
                    }
                }
            }
        }

        persistenceError?.let { vaultEx ->
            val successor = (refreshResult as? ApiResult.Success)?.value
            if (successor != null) {
                onCredentialPersistenceFailed(key, successor, vaultEx)
            }
        }

        return finalResult
    }

    override suspend fun checkAccess(): ApiResult<AccessRequestInfo?> {
        val (token, gen) = sessionMutex.withLock {
            val t = inMemoryBundle?.accessToken
            val g = currentGeneration
            if (t == null) null else Pair(t, g)
        } ?: return ApiResult.Failure(
            SafeError.Unauthorized(
                code = "UNAUTHENTICATED",
                message = "Cannot check access without active credentials"
            )
        )
        val meResult = authClient.getMe(token)
        return when (meResult) {
            is ApiResult.Failure -> {
                if (meResult.error is SafeError.Unauthorized) {
                    when (val refreshOutcome = refresh()) {
                        is ApiResult.Failure -> {
                            sessionMutex.withLock {
                                if (currentGeneration == gen && refreshOutcome.error is SafeError.Unauthorized) {
                                    _state.value = AuthState.REAUTH_REQUIRED
                                }
                            }
                            return refreshOutcome
                        }
                        is ApiResult.Success -> {
                            val refreshedToken = sessionMutex.withLock { inMemoryBundle?.accessToken }
                                ?: return ApiResult.Failure(
                                    SafeError.Unauthorized("UNAUTHENTICATED", "No credentials after refresh")
                                )
                            val secondMe = authClient.getMe(refreshedToken)
                            when (secondMe) {
                                is ApiResult.Failure -> secondMe
                                is ApiResult.Success -> handleMeAccessEvaluation(secondMe.value, refreshedToken, gen)
                            }
                        }
                    }
                } else {
                    meResult
                }
            }
            is ApiResult.Success -> {
                handleMeAccessEvaluation(meResult.value, token, gen)
            }
        }
    }

    private suspend fun handleMeAccessEvaluation(
        me: MeResponse,
        token: String,
        gen: Long
    ): ApiResult<AccessRequestInfo?> {
        val hasAccess = me.hasTabbyRushAccess(config.appId)
        sessionMutex.withLock {
            if (currentGeneration == gen) {
                if (hasAccess) {
                    _state.value = AuthState.AUTHENTICATED
                } else {
                    _state.value = AuthState.ACCESS_PENDING
                }
            }
        }

        // Query access requests to explain status to user/UI
        val listResult = authClient.getAccessRequests(token)
        return when (listResult) {
            is ApiResult.Success -> {
                val requests = listResult.value
                val latest = requests
                    .filter { it.appId == config.appId }
                    .maxByOrNull { it.createdAt }
                    ?.toAccessRequestInfo()
                ApiResult.Success(latest)
            }
            is ApiResult.Failure -> {
                ApiResult.Success(null)
            }
        }
    }

    override suspend fun requestAccess(message: String?): ApiResult<AccessRequestInfo> {
        val (token, gen) = sessionMutex.withLock {
            val t = inMemoryBundle?.accessToken
            val g = currentGeneration
            if (t == null) null else Pair(t, g)
        } ?: return ApiResult.Failure(
            SafeError.Unauthorized(
                code = "UNAUTHENTICATED",
                message = "Cannot submit access request without active credentials"
            )
        )
        val submitResult = authClient.requestAccess(
            accessToken = token,
            appId = config.appId,
            message = message
        )

        return when (submitResult) {
            is ApiResult.Success -> {
                val info = submitResult.value.toAccessRequestInfo()
                ApiResult.Success(info)
            }
            is ApiResult.Failure -> {
                // On failure (e.g. duplicate pending), perform bounded own-list reconciliation
                val listResult = authClient.getAccessRequests(token)
                when (listResult) {
                    is ApiResult.Success -> {
                        val latest = listResult.value
                            .filter { it.appId == config.appId }
                            .maxByOrNull { it.createdAt }
                            ?.toAccessRequestInfo()

                        if (latest != null) {
                            ApiResult.Success(latest)
                        } else {
                            submitResult
                        }
                    }
                    is ApiResult.Failure -> {
                        submitResult
                    }
                }
            }
        }
    }

    override suspend fun lookupUser(username: String): ApiResult<UserLookupResult> {
        val (token, gen) = sessionMutex.withLock {
            if (_state.value != AuthState.AUTHENTICATED) {
                return ApiResult.Failure(
                    SafeError.Unauthorized(
                        code = "UNAUTHENTICATED",
                        message = "Operation requires an authenticated session"
                    )
                )
            }
            Pair(inMemoryBundle?.accessToken, currentGeneration)
        }
        if (token == null) {
            return ApiResult.Failure(
                SafeError.Unauthorized(
                    code = "UNAUTHENTICATED",
                    message = "Operation requires an authenticated session"
                )
            )
        }
        val result = authClient.lookupUser(token, username)
        sessionMutex.withLock {
            if (currentGeneration != gen || _state.value != AuthState.AUTHENTICATED) {
                return ApiResult.Failure(
                    SafeError.Unauthorized(
                        code = "ACCOUNT_CHANGED",
                        message = "Account session changed during user lookup"
                    )
                )
            }
        }
        return when (result) {
            is ApiResult.Success -> {
                val user = result.value.user
                if (user != null) {
                    ApiResult.Success(UserLookupResult(userId = user.userId, username = user.username))
                } else {
                    ApiResult.Failure(
                        SafeError.Validation(
                            code = "USER_NOT_FOUND",
                            message = "User not found: $username"
                        )
                    )
                }
            }
            is ApiResult.Failure -> result
        }
    }

    /**
     * Executes an authorized operation.
     * Enforces the critical invariant: HTTP auth layer NEVER automatically replays a POST
     * after token refresh. Caller coordinator retains frozen operation intent.
     */
    suspend fun <T> authorizedRequest(
        expectedAccountKey: AccountKey? = null,
        block: suspend (accessToken: String) -> ApiResult<T>
    ): ApiResult<T> {
        val (token, gen) = sessionMutex.withLock {
            if (_state.value != AuthState.AUTHENTICATED) {
                return ApiResult.Failure(
                    SafeError.Unauthorized(
                        code = "UNAUTHENTICATED",
                        message = "Operation requires an authenticated session"
                    )
                )
            }
            if (expectedAccountKey != null && _currentAccountKey.value != expectedAccountKey) {
                return ApiResult.Failure(SafeError.Unauthorized("ACCOUNT_FENCED", "Request belongs to a different account"))
            }
            Pair(inMemoryBundle?.accessToken, currentGeneration)
        }

        if (token == null) {
            return ApiResult.Failure(
                SafeError.Unauthorized(
                    code = "UNAUTHENTICATED",
                    message = "Operation requires an authenticated session"
                )
            )
        }

        val firstAttempt = block(token)
        when (firstAttempt) {
            is ApiResult.Success -> return firstAttempt
            is ApiResult.Failure -> {
                if (firstAttempt.error !is SafeError.Unauthorized) {
                    return firstAttempt
                }

                // Invalid API key is an application configuration error, not a refreshable JWT session expiration!
                if (firstAttempt.error.code == "INVALID_API_KEY" ||
                    firstAttempt.error.message.contains("API key", ignoreCase = true)
                ) {
                    return firstAttempt
                }
                val admissionChanged = sessionMutex.withLock {
                    currentGeneration != gen || (expectedAccountKey != null && _currentAccountKey.value != expectedAccountKey)
                }
                if (admissionChanged) return ApiResult.Failure(SafeError.Unauthorized("ACCOUNT_FENCED", "Account changed before refresh"))

                // 401 is ambiguous: JWT expiry, missing grant, or bad key.
                // Perform at most one single-flight refresh recovery:
                when (val refreshOutcome = refresh()) {
                    is ApiResult.Failure -> {
                        sessionMutex.withLock {
                            if (currentGeneration == gen && refreshOutcome.error is SafeError.Unauthorized) {
                                _state.value = AuthState.REAUTH_REQUIRED
                            }
                        }
                        return refreshOutcome
                    }
                    is ApiResult.Success -> {
                        val newToken = sessionMutex.withLock { inMemoryBundle?.accessToken }
                            ?: return ApiResult.Failure(
                                SafeError.Unauthorized("UNAUTHENTICATED", "No credentials after refresh")
                            )

                        val meCheck = authClient.getMe(newToken)
                        when (meCheck) {
                            is ApiResult.Failure -> {
                                sessionMutex.withLock {
                                    if (currentGeneration == gen) {
                                        _state.value = AuthState.REAUTH_REQUIRED
                                    }
                                }
                                return ApiResult.Failure(
                                    SafeError.Unauthorized(
                                        code = "REAUTH_REQUIRED",
                                        message = "Token refreshed but user verification failed"
                                    )
                                )
                            }
                            is ApiResult.Success -> {
                                val me = meCheck.value
                                sessionMutex.withLock {
                                    if (currentGeneration == gen) {
                                        if (!me.hasTabbyRushAccess(config.appId)) {
                                            _state.value = AuthState.ACCESS_PENDING
                                        } else {
                                            _state.value = AuthState.AUTHENTICATED
                                        }
                                    }
                                }

                                if (!me.hasTabbyRushAccess(config.appId)) {
                                    return ApiResult.Failure(
                                        SafeError.AccessPending(
                                            code = "ACCESS_PENDING",
                                            message = "Account does not possess the tabbyrush application grant"
                                        )
                                    )
                                } else {
                                    // DO NOT automatically replay the POST request!
                                    return ApiResult.Failure(
                                        SafeError.Unauthorized(
                                            code = "TOKEN_REFRESHED",
                                            message = "Token refreshed; coordinator must control retry of operation"
                                        )
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    /**
     * Increments the generation fence to prevent any in-flight asynchronous operations
     * from restoring credentials or altering session state.
     */
    suspend fun quiesce() = sessionMutex.withLock {
        currentGeneration++
    }

    /**
     * Local-only logout: clears in-memory credentials and deletes vault bundle.
     * Does NOT call remote revocation (Hub issued tokens expire via TTL).
     */
    override suspend fun logout() = sessionMutex.withLock {
        currentGeneration++
        val key = _currentAccountKey.value
        if (key != null) {
            try {
                vault.clear(key)
            } catch (_: Exception) {
                // Best-effort clear
            }
        }
        inMemoryBundle = null
        _currentIdentity.value = null
        _currentAccountKey.value = null
        _state.value = AuthState.UNAUTHENTICATED
    }

    /**
     * Clears local credentials called by 05 leave sequence with generation fencing.
     */
    suspend fun clearLocalCredentials() {
        logout()
    }

    override fun close() {
        authClient.close()
    }
}
