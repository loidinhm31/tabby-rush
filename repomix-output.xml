package dev.tabbyrush.shared.sync

import dev.tabbyrush.shared.contract.AccountKey
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.withTimeoutOrNull

/**
 * State of the ReminderDeliveryGate.
 */
enum class DeliveryGateState {
    OPEN,
    CLOSING,
    CLOSED
}

/**
 * ReminderDeliveryGate coordinates concurrency between:
 * 1. Store mutations (local save/delete/reconcile/scan/transition)
 * 2. Delivery callbacks (alarm triggered, claiming, and native posting)
 * 3. Account teardown (leave, logout, wipe)
 *
 * Enforces strict lock ordering:
 *   delivery gate admission -> store mutex -> DB transaction
 *   (Never inverse; never wait for network under gate admission).
 */
class ReminderDeliveryGate(
    val accountKey: AccountKey,
    val getPersistedGeneration: suspend () -> Long,
    val hasPendingWipeMarker: suspend () -> Boolean
) {
    private val stateMutex = Mutex()
    private var state = DeliveryGateState.OPEN
    private var inFlightDeliveries = 0
    private var inFlightMutations = 0
    private var drainSignal: CompletableDeferred<Unit>? = null

    suspend fun getState(): DeliveryGateState = stateMutex.withLock { state }

    /**
     * Executes [block] under mutation admission.
     * Enforces lock ordering: delivery gate -> store mutex -> DB transaction.
     */
    suspend fun <T> withMutationAdmission(block: suspend () -> T): T {
        stateMutex.withLock {
            check(state == DeliveryGateState.OPEN) {
                "Mutation admission rejected: delivery gate is $state"
            }
            inFlightMutations++
        }

        try {
            return block()
        } finally {
            stateMutex.withLock {
                inFlightMutations--
            }
        }
    }

    /**
     * Executes [block] under delivery callback admission.
     * Checks gate state, wipe marker, and persisted generation.
     * Fails closed if gate is closing/closed, wipe marker is present, or generation changed.
     */
    suspend fun <T> withDeliveryAdmission(
        expectedGeneration: Long,
        block: suspend () -> T
    ): T? {
        stateMutex.withLock {
            if (state != DeliveryGateState.OPEN) {
                return null // Fail closed
            }
            inFlightDeliveries++
        }

        try {
            // Check wipe marker and generation outside DB transaction
            if (hasPendingWipeMarker()) {
                return null // Fail closed: account is being wiped
            }
            val currentGen = try {
                getPersistedGeneration()
            } catch (_: Exception) {
                return null // Generation check failure fails closed
            }
            if (currentGen != expectedGeneration) {
                return null // Generation mismatch: stale callback
            }

            return block()
        } finally {
            val signalToComplete: CompletableDeferred<Unit>?
            stateMutex.withLock {
                inFlightDeliveries--
                if (state != DeliveryGateState.OPEN && inFlightDeliveries == 0) {
                    signalToComplete = drainSignal
                } else {
                    signalToComplete = null
                }
            }
            signalToComplete?.complete(Unit)
        }
    }

    /**
     * Closes delivery admission and drains all in-flight delivery callbacks.
     * Called during account leave / teardown before Room is closed.
     * Returns true if drained cleanly within [timeoutMs]; false if timed out.
     */
    suspend fun closeAndDrain(timeoutMs: Long = 5000L): Boolean {
        stateMutex.withLock {
            if (state == DeliveryGateState.CLOSED) return true
            state = DeliveryGateState.CLOSING
            if (inFlightDeliveries == 0 && inFlightMutations == 0) {
                state = DeliveryGateState.CLOSED
                return true
            }
        }

        val drained = withTimeoutOrNull(timeoutMs) {
            while (true) {
                val done = stateMutex.withLock {
                    inFlightDeliveries == 0 && inFlightMutations == 0
                }
                if (done) break
                kotlinx.coroutines.delay(10)
            }
            true
        } ?: false

        stateMutex.withLock {
            if (drained && inFlightDeliveries == 0 && inFlightMutations == 0) {
                state = DeliveryGateState.CLOSED
            }
        }

        return drained
    }
}
</file>

<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/sync/reminder-scheduling-coordinator.kt">
package dev.tabbyrush.shared.sync

import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.contract.NativeReminderAdapter
import dev.tabbyrush.shared.contract.ScheduledAlarmHandle
import dev.tabbyrush.shared.contract.TaskAccessStatus
import dev.tabbyrush.shared.contract.TaskRef
import dev.tabbyrush.shared.data.ReminderOccurrenceStore
import dev.tabbyrush.shared.data.RoomAccountStore

/**
 * ReminderSchedulingCoordinator manages the per-account reminder lifecycle.
 * Coordinates reactive persisted schedule observation, OS alarm reconciliation,
 * and fail-closed claim-before-post delivery execution under the ReminderDeliveryGate.
 */
class ReminderSchedulingCoordinator(
    val accountKey: AccountKey,
    val store: RoomAccountStore,
    val occurrenceStore: ReminderOccurrenceStore,
    val adapter: NativeReminderAdapter,
    val deliveryGate: ReminderDeliveryGate,
    val getGeneration: suspend () -> Long,
    val hasWipeMarker: suspend () -> Boolean,
    val clock: () -> Long = { System.currentTimeMillis() }
) : LeaveSchedulerCancelGate {

    init {
        store.deliveryGate = deliveryGate
    }

    /**
     * Reconciles current persisted schedule with OS alarm scheduler and removes
     * obsolete posted notifications.
     */
    suspend fun reconcile(nowEpochMs: Long = clock()) {
        if (deliveryGate.getState() != DeliveryGateState.OPEN || hasWipeMarker()) {
            return // Gate closed or account wiping: fail closed
        }

        deliveryGate.withMutationAdmission {
            if (hasWipeMarker()) return@withMutationAdmission

            val generation = try {
                getGeneration()
            } catch (_: Exception) {
                return@withMutationAdmission
            }

            val schedules = store.getPersistedScheduleProjection()
            val delta = occurrenceStore.syncPlannedOccurrences(generation, schedules, nowEpochMs)

            val handles = delta.alarmsToSchedule.map {
                ScheduledAlarmHandle(
                    accountKey = it.accountKey,
                    generation = it.generation,
                    taskRef = TaskRef(it.ownerUserId ?: store.userId, it.taskId),
                    scheduleToken = it.scheduleToken,
                    occurrenceIndex = it.occurrenceIndex,
                    triggerAtEpochMs = it.dueEpochMs
                )
            }

            adapter.reconcileSchedule(accountKey, generation, handles)

            for (obsoleteId in delta.obsoletePlatformNotificationIdsToRemove) {
                adapter.removeOwnedNotification(accountKey, obsoleteId)
                occurrenceStore.clearPostedNotificationId(generation, obsoleteId, nowEpochMs)
            }
        }
    }

    /**
     * Executes claim-before-post notification delivery when an alarm callback fires.
     * Enforces:
     * 1. Delivery gate admission (fail closed if closing, closed, or wiped).
     * 2. Capability verification.
     * 3. Current persisted task eligibility & access re-check.
     * 4. Atomic claim in SQLite before native post.
     * 5. Pre-post wipe marker, gate state, and fresh projection re-check.
     * 6. Native post followed by outcome recording.
     */
    suspend fun deliverReminder(
        taskRef: TaskRef,
        scheduleToken: String,
        occurrenceIndex: Int,
        triggerGeneration: Long,
        nowEpochMs: Long = clock()
    ): Boolean {
        return deliveryGate.withDeliveryAdmission(expectedGeneration = triggerGeneration) {
            if (hasWipeMarker()) return@withDeliveryAdmission false

            val caps = adapter.queryCapabilities()
            if (!caps.isDeliveryPermitted) return@withDeliveryAdmission false

            if (taskRef.ownerUserId != store.userId) {
                val access = store.accessFor(taskRef)
                if (access == null || access.status != TaskAccessStatus.Accessible) {
                    return@withDeliveryAdmission false
                }
            }

            // Re-read current persisted task projection (fresh content and eligibility)
            val schedules = store.getPersistedScheduleProjection()
            val taskSchedule = schedules.find { it.ownerUserId == taskRef.ownerUserId && it.taskId == taskRef.rowId }
            if (taskSchedule == null || !taskSchedule.isEligibleForScheduling || taskSchedule.scheduleToken != scheduleToken) {
                // Task was deleted, completed, disabled, or token changed: cancel and do not post
                occurrenceStore.syncPlannedOccurrences(triggerGeneration, schedules, nowEpochMs)
                return@withDeliveryAdmission false
            }

            // Atomic claim-before-post in SQLite
            val claimed = occurrenceStore.evaluateAndClaimDueOpportunity(
                generation = triggerGeneration,
                taskId = taskRef.rowId,
                scheduleToken = scheduleToken,
                nowEpochMs = nowEpochMs
            ) ?: return@withDeliveryAdmission false

            // Pre-post re-check outside DB transaction
            if (hasWipeMarker() || deliveryGate.getState() != DeliveryGateState.OPEN) {
                return@withDeliveryAdmission false
            }

            if (taskRef.ownerUserId != store.userId) {
                val prePostAccess = store.accessFor(taskRef)
                if (prePostAccess == null || prePostAccess.status != TaskAccessStatus.Accessible) {
                    return@withDeliveryAdmission false
                }
            }

            val prePostSchedule = store.getPersistedScheduleProjection().find { it.ownerUserId == taskRef.ownerUserId && it.taskId == taskRef.rowId }
            if (prePostSchedule == null || !prePostSchedule.isEligibleForScheduling || prePostSchedule.scheduleToken != scheduleToken) {
                return@withDeliveryAdmission false
            }

            val title = prePostSchedule.title

            // Native post
            val platformId = adapter.postOwnedNotification(
                accountKey = accountKey,
                generation = triggerGeneration,
                taskRef = taskRef,
                scheduleToken = scheduleToken,
                occurrenceIndex = claimed.index,
                title = title,
                dueEpochMs = claimed.dueEpochMs
            )

            if (platformId != null) {
                occurrenceStore.recordPosted(
                    generation = triggerGeneration,
                    taskId = taskRef.rowId,
                    scheduleToken = scheduleToken,
                    occurrenceIndex = claimed.index,
                    platformNotificationId = platformId,
                    nowEpochMs = nowEpochMs
                )
                true
            } else {
                // Posting failed/blocked: retained as claimed/attempted, no retry
                false
            }
        } ?: false
    }

    suspend fun deliverReminder(
        taskId: String,
        scheduleToken: String,
        occurrenceIndex: Int,
        triggerGeneration: Long,
        nowEpochMs: Long = clock()
    ): Boolean = deliverReminder(
        taskRef = TaskRef(store.userId, taskId),
        scheduleToken = scheduleToken,
        occurrenceIndex = occurrenceIndex,
        triggerGeneration = triggerGeneration,
        nowEpochMs = nowEpochMs
    )

    /**
     * Implements LeaveSchedulerCancelGate to cancel all alarms and posted notifications
     * on account leave or teardown.
     */
    override suspend fun cancelAndAwait(accountKey: AccountKey) {
        adapter.cancelAllForAccount(accountKey)
    }
}
</file>

<file path="shared/src/commonMain/kotlin/dev/tabbyrush/shared/sync/task-json-merge.kt">
package dev.tabbyrush.shared.sync

import dev.tabbyrush.shared.contract.*
import dev.tabbyrush.shared.data.OutboxEntity
import dev.tabbyrush.shared.data.ServerBaseEntity
import kotlinx.serialization.encodeToString
import kotlinx.serialization.json.*

/** Only locally changed known fields replace values. Opaque JSON is never round-tripped through TaskData. */
object TaskJsonMerge {
    val json = Json { ignoreUnknownKeys = true; encodeDefaults = true; explicitNulls = true }
    private val deadlineKeys = setOf("deadlineDate", "deadlineTime", "deadlineZone", "deadlineOffsetSeconds", "reminderAnchorTime", "deadlineAnchorEpochMs", "deadlineOverdueEpochMs", "scheduleToken")
    private val reminderKeys = setOf("reminderEnabled", "reminderLeadMinutes", "reminderIntervalMinutes", "reminderCount", "scheduleToken")
    val masks = setOf("TITLE", "COMPLETED", "DEADLINE", "REMINDER", "PARENT", "DELETE", "LAST_CHILD_PRESERVATION")

    fun encode(todo: Todo): JsonObject = json.encodeToJsonElement(todo.toTaskData()).jsonObject

    fun merge(base: JsonObject, intent: JsonObject, mask: String?): JsonObject {
        val parts = requireNotNull(mask) { "Unknown local intent" }.split('|').toSet()
        require(parts.isNotEmpty() && parts.all { it in masks }) { "Unknown local intent mask" }
        val keys = mutableSetOf<String>()
        if ("TITLE" in parts) keys.add("title")
        if ("COMPLETED" in parts) keys.add("completed")
        if ("DEADLINE" in parts) keys.addAll(deadlineKeys + reminderKeys)
        if ("REMINDER" in parts) keys.addAll(reminderKeys)
        if ("PARENT" in parts) keys.add("parentTaskId")
        return JsonObject(base.toMutableMap().apply {
            for (key in keys) {
                put(key, intent[key] ?: JsonNull)
            }
        })
    }

    fun decodeRelation(rowId: String, raw: JsonObject): String? {
        val id = raw["id"]?.let { if (it is JsonPrimitive && it.isString) it.content else null }
        val taskId = raw["taskId"]?.let { if (it is JsonPrimitive && it.isString) it.content else null }
        require(id == rowId) { "Relation id mismatch: expected $rowId, got $id" }
        require(taskId == rowId) { "Relation taskId mismatch: expected $rowId, got $taskId" }
        val userEl = raw["userId"]
        return if (userEl == null || userEl is JsonNull) null
        else if (userEl is JsonPrimitive && userEl.isString) userEl.content
        else throw IllegalArgumentException("Invalid userId in relation")
    }

    fun encodeRelation(taskId: String, recipientUserId: String?): JsonObject = buildJsonObject {
        put("id", taskId)
        put("taskId", taskId)
        if (recipientUserId != null) {
            put("userId", recipientUserId)
        } else {
            put("userId", JsonNull)
        }
    }

    fun decode(rowId: String, raw: JsonObject): TaskData {
        for (key in setOf("id", "title")) require(raw[key] is JsonPrimitive && raw[key]!!.jsonPrimitive.isString) { "Invalid $key" }
        for (key in setOf("completed", "reminderEnabled")) {
            val value = raw[key]?.jsonPrimitive
            require(value != null && !value.isString && value.booleanOrNull != null) { "Invalid $key" }
        }
        for (key in setOf("createdAt", "reminderLeadMinutes", "reminderCount")) {
            val value = raw[key]?.jsonPrimitive
            require(value != null && !value.isString && value.longOrNull != null) { "Invalid $key" }
        }
        for (key in setOf("deadlineDate", "deadlineTime", "deadlineZone", "reminderAnchorTime", "scheduleToken", "parentTaskId")) {
            val value = raw[key] ?: continue
            require(value == JsonNull || (value is JsonPrimitive && value.isString)) { "Invalid $key" }
        }
        for (key in setOf("deadlineOffsetSeconds", "deadlineAnchorEpochMs", "deadlineOverdueEpochMs", "reminderIntervalMinutes")) {
            val value = raw[key] ?: continue
            require(value == JsonNull || (value is JsonPrimitive && !value.isString && value.longOrNull != null)) { "Invalid $key" }
        }
        val data = json.decodeFromJsonElement<TaskData>(raw)
        require(data.id == rowId) { "Task identity mismatch" }
        data.validate()
        validateDeadlineInstants(data)
        data.toTodo() // includes checked reminder arithmetic
        return data
    }

    private fun validateDeadlineInstants(data: TaskData) {
        val date = data.deadlineDate ?: return
        val zone = requireNotNull(data.deadlineZone)
        val time = requireNotNull(data.deadlineTime ?: data.reminderAnchorTime)
        val offset = requireNotNull(data.deadlineOffsetSeconds)
        val resolver = StrictTimeZoneResolver.default
        // Resolver rejects gaps/invalid offsets and honors the captured offset in a DST overlap.
        val anchor = resolver.resolveInstant(zone, date, time, offset)
        require(data.deadlineAnchorEpochMs == anchor) { "Deadline anchor does not match civil time" }
        val overdue = if (data.deadlineTime != null) anchor else resolver.computeNextCalendarDayStartEpochMs(zone, date)
        require(data.deadlineOverdueEpochMs == overdue) { "Deadline overdue boundary does not match civil date" }
    }

    fun project(record: PullRecordDto): ServerBaseEntity {
        require((record.tableName == "todos" || record.tableName == "taskAssignees") && record.rowId.isNotEmpty()) {
            "Unexpected record identity: table=${record.tableName}, rowId=${record.rowId}"
        }
        require(record.version in 1..MAX_EXACT_VERSION) { "Invalid record version" }
        val owner = record.ownerUserId
        val boundKey = if (owner != null && owner.isNotBlank()) dev.tabbyrush.shared.data.boundBindingKey(owner) else dev.tabbyrush.shared.data.BINDING_LOCAL_ACCOUNT
        val bindingState = if (owner != null && owner.isNotBlank()) dev.tabbyrush.shared.data.BINDING_BOUND else dev.tabbyrush.shared.data.BINDING_LOCAL_ACCOUNT

        if (record.tableName == "taskAssignees") {
            val relation = if (record.deleted) null else runCatching { decodeRelation(record.rowId, record.data.jsonObject) }.getOrNull()
            return ServerBaseEntity(
                bindingKey = boundKey,
                ownerBinding = bindingState,
                ownerUserId = owner,
                tableName = record.tableName,
                rowId = record.rowId,
                serverRevision = record.version,
                deleted = record.deleted,
                rawJson = record.data.toString(),
                syncedAt = record.syncedAt,
                standardConfirmed = true,
                projectionError = if (!record.deleted && relation == null && record.data !is JsonNull) "Remote relation fields are incompatible; raw data retained" else null
            )
        }

        val data = if (record.deleted) null else runCatching { decode(record.rowId, record.data.jsonObject) }.getOrNull()
        return ServerBaseEntity(
            bindingKey = boundKey,
            ownerBinding = bindingState,
            ownerUserId = owner,
            tableName = record.tableName,
            rowId = record.rowId,
            serverRevision = record.version,
            deleted = record.deleted,
            title = data?.title ?: "",
            completed = data?.completed ?: false,
            createdAt = data?.createdAt ?: 0L,
            updatedAt = data?.createdAt ?: 0L,
            deadlineDate = data?.deadlineDate,
            deadlineTime = data?.deadlineTime,
            deadlineZone = data?.deadlineZone,
            deadlineOffsetSeconds = data?.deadlineOffsetSeconds,
            reminderAnchorTime = data?.reminderAnchorTime,
            deadlineAnchorEpochMs = data?.deadlineAnchorEpochMs,
            deadlineOverdueEpochMs = data?.deadlineOverdueEpochMs,
            reminderEnabled = data?.reminderEnabled ?: false,
            reminderLeadMinutes = data?.reminderLeadMinutes ?: 0L,
            reminderIntervalMinutes = data?.reminderIntervalMinutes,
            reminderCount = data?.reminderCount ?: 1L,
            scheduleToken = data?.scheduleToken,
            parentTaskId = data?.parentTaskId,
            rawJson = record.data.toString(),
            syncedAt = record.syncedAt,
            standardConfirmed = true,
            projectionError = if (!record.deleted && data == null) "Remote task fields are incompatible; raw data retained for review" else null
        )
    }
}

fun TaskData.toTodo(ownerUserId: String = "local"): Todo = Todo(
    taskRef = TaskRef(if (ownerUserId.isNotBlank()) ownerUserId else "local", id),
    title = title,
    completed = completed,
    createdAt = createdAt,
    deadline = toDeadline(),
    reminderRule = toReminderRule(),
    scheduleToken = scheduleToken,
    parentTaskRef = parentTaskId?.let { TaskRef(if (ownerUserId.isNotBlank()) ownerUserId else "local", it) }
)

fun OutboxEntity.intentJson(): JsonObject = if (payloadJson != "{}") TaskJsonMerge.json.parseToJsonElement(payloadJson).jsonObject else {
    TaskJsonMerge.json.encodeToJsonElement(TaskData(
        id = rowId, title = title ?: "", completed = completed ?: false, createdAt = createdAt ?: 0L,
        deadlineDate = deadlineDate, deadlineTime = deadlineTime, deadlineZone = deadlineZone,
        deadlineOffsetSeconds = deadlineOffsetSeconds, reminderAnchorTime = reminderAnchorTime,
        deadlineAnchorEpochMs = deadlineAnchorEpochMs, deadlineOverdueEpochMs = deadlineOverdueEpochMs,
        reminderEnabled = reminderEnabled, reminderLeadMinutes = reminderLeadMinutes,
        reminderIntervalMinutes = reminderIntervalMinutes, reminderCount = reminderCount,
        scheduleToken = scheduleToken, parentTaskId = parentTaskId
    )).jsonObject
}
</file>

