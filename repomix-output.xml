package dev.tabbyrush.desktop.linux

import org.freedesktop.dbus.exceptions.DBusException
import org.freedesktop.dbus.exceptions.DBusExecutionException
import org.freedesktop.dbus.types.UInt32
import org.freedesktop.dbus.types.Variant
import java.lang.reflect.Proxy
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertTrue

class LinuxNotificationAdapterTest {

    private class FakeNotificationTransport(
        private val proxy: FreedesktopNotifications? = null,
        private val throwConnectionException: Boolean = false
    ) : NotificationTransport {
        override fun <T> withProxy(block: (FreedesktopNotifications) -> T): T {
            if (throwConnectionException) {
                throw DBusException("Simulated connection failure to user bus")
            }
            return block(requireNotNull(proxy))
        }
    }

    private fun createFakeAdapter(
        capabilities: List<String> = listOf("body", "actions", "icon-static"),
        nextId: UInt32 = UInt32(42L),
        throwExecutionException: Boolean = false,
        throwConnectionException: Boolean = false
    ): DbusLinuxNotificationAdapter {
        if (throwConnectionException) {
            return DbusLinuxNotificationAdapter(FakeNotificationTransport(throwConnectionException = true))
        }

        val fakeProxy = Proxy.newProxyInstance(
            FreedesktopNotifications::class.java.classLoader,
            arrayOf(FreedesktopNotifications::class.java)
        ) { _, method, _ ->
            if (throwExecutionException) {
                throw DBusExecutionException("org.freedesktop.DBus.Error.ServiceUnknown: The name is not activatable")
            }
            when (method.name) {
                "GetCapabilities" -> capabilities
                "Notify" -> nextId
                "CloseNotification" -> null
                "isRemote" -> true
                "getObjectPath" -> "/org/freedesktop/Notifications"
                "getInterface" -> FreedesktopNotifications::class.java
                else -> null
            }
        } as FreedesktopNotifications

        return DbusLinuxNotificationAdapter(FakeNotificationTransport(fakeProxy))
    }

    @Test
    fun testSuccessfulCapabilitiesAndNotification() {
        val adapter = createFakeAdapter(capabilities = listOf("body", "actions"), nextId = UInt32(99L))

        val (capStatus, caps) = adapter.checkCapabilities()
        assertTrue(capStatus is LinuxNotificationStatus.Success)
        assertEquals(setOf("body", "actions"), caps)

        val notifyStatus = adapter.postNotification(
            title = "Task Due",
            body = "Complete quarterly report"
        )
        assertTrue(notifyStatus is LinuxNotificationStatus.Success)
        assertEquals(99L, notifyStatus.notificationId)

        val closeStatus = adapter.closeNotification(99L)
        assertTrue(closeStatus is LinuxNotificationStatus.Closed)
        assertEquals(99L, closeStatus.notificationId)
    }

    @Test
    fun testMissingDaemonServiceUnknownHandling() {
        val adapter = createFakeAdapter(throwExecutionException = true)

        val (capStatus, caps) = adapter.checkCapabilities()
        assertTrue(capStatus is LinuxNotificationStatus.Unavailable)
        assertTrue(caps.isEmpty())
        assertTrue(capStatus.reason.contains("ServiceUnknown") || capStatus.reason.contains("unavailable"))

        val notifyStatus = adapter.postNotification(
            title = "Task Due",
            body = "Complete quarterly report"
        )
        assertTrue(notifyStatus is LinuxNotificationStatus.Unavailable)

        val closeStatus = adapter.closeNotification(123L)
        assertTrue(closeStatus is LinuxNotificationStatus.Unavailable)
    }

    @Test
    fun testMissingDbusSessionConnectionHandling() {
        val adapter = createFakeAdapter(throwConnectionException = true)

        val (capStatus, caps) = adapter.checkCapabilities()
        assertTrue(capStatus is LinuxNotificationStatus.Unavailable)
        assertTrue(caps.isEmpty())
        assertTrue(capStatus.reason.contains("unavailable") || capStatus.reason.contains("failure"))

        val notifyStatus = adapter.postNotification(
            title = "Task Due",
            body = "Complete quarterly report"
        )
        assertTrue(notifyStatus is LinuxNotificationStatus.Unavailable)
    }

    @Test
    fun testHostEnvironmentProbeSafeExecution() {
        val liveAdapter = DbusLinuxNotificationAdapter()
        val (capStatus, _) = liveAdapter.checkCapabilities()
        // Must either succeed (if a daemon is active) or report unavailable safely
        assertTrue(
            capStatus is LinuxNotificationStatus.Success || capStatus is LinuxNotificationStatus.Unavailable,
            "Live host probe must produce Success or Unavailable status, got: $capStatus"
        )
    }

    @Test
    fun testSignalDeclarationsConstructible() {
        val actionSignal = FreedesktopNotifications.ActionInvoked(
            "/org/freedesktop/Notifications",
            UInt32(42L),
            "default"
        )
        assertEquals(UInt32(42L), actionSignal.id)
        assertEquals("default", actionSignal.action)

        val closedSignal = FreedesktopNotifications.NotificationClosed(
            "/org/freedesktop/Notifications",
            UInt32(42L),
            UInt32(2L)
        )
        assertEquals(UInt32(42L), closedSignal.id)
        assertEquals(UInt32(2L), closedSignal.reason)
    }

    @Test
    fun testPersistentTransportHostEnvironmentSafeExecution() {
        val transport = DbusPersistentNotificationTransport()
        try {
            val connected = transport.connect()
            if (connected) {
                assertTrue(transport.isConnected())
                val owner = transport.getDaemonOwner()
                // If connected, owner is either a valid bus name or null if no daemon
                assertTrue(owner == null || owner.startsWith(":"))
            } else {
                assertFalse(transport.isConnected())
            }
        } finally {
            transport.close()
            assertFalse(transport.isConnected())
        }
    }
}
</file>

<file path="desktopApp/src/main/kotlin/dev/tabbyrush/desktop/composite-desktop-leave-cancel-gate.kt">
package dev.tabbyrush.desktop

import dev.tabbyrush.shared.contract.AccountKey
import dev.tabbyrush.shared.sync.LeaveSchedulerCancelGate
import dev.tabbyrush.shared.sync.ReminderDeliveryGate
import kotlinx.coroutines.Job
import kotlinx.coroutines.cancelAndJoin

/**
 * Composite cancel gate coordinating clean quiescence across desktop runtime producers:
 * 1. [ReminderDeliveryGate] (stops new reminder deliveries, drains active callbacks)
 * 2. Surface cancel gate (stops new surface operations/mutations, drains in-flight surface work)
 * 3. Surface observer job (cancels reactive Room surface todos observation)
 * 4. Schedule observation job (cancels reactive Room schedule updates)
 * 5. [DesktopReminderScheduler] (cancels desktop wake loop and clears pending alarm handles)
 * 6. Sync scheduler cancel gate (cancels periodic/immediate sync rounds, awaits active sync jobs)
 * 7. Reminder coordinator cancel gate (cancels and clears native platform notifications)
 * 8. Remote runtime cancel gate (fences generation, cancels streams/timers, clears remote notifications)
 * Invariants:
 * If any cancellation or drain step fails or times out, throws an exception so
 * [dev.tabbyrush.shared.sync.AccountLeaveProtocol] remains fail-closed with wipe markers intact
 * and database files protected.
 */
class CompositeDesktopLeaveCancelGate(
    private val deliveryGate: ReminderDeliveryGate,
    private val scheduleObserverJob: Job,
    private val reminderScheduler: DesktopReminderScheduler,
    private val syncCancelGate: LeaveSchedulerCancelGate,
    private val reminderCancelGate: LeaveSchedulerCancelGate,
    private val surfaceObserverJob: Job? = null,
    private val surfaceCancelGate: LeaveSchedulerCancelGate? = null,
    private val remoteCancelGate: LeaveSchedulerCancelGate? = null,
    private val drainTimeoutMs: Long = 5000L
) : LeaveSchedulerCancelGate {

    override suspend fun cancelAndAwait(accountKey: AccountKey) {
        // 1. Close delivery gate and drain in-flight delivery admissions
        val drained = deliveryGate.closeAndDrain(drainTimeoutMs)
        if (!drained) {
            throw IllegalStateException("Timed out draining in-flight reminder deliveries for $accountKey")
        }

        // 2. Drain surface admissions before stopping observers
        surfaceCancelGate?.cancelAndAwait(accountKey)

        // 3. Stop reactive task surface observer
        surfaceObserverJob?.cancelAndJoin()

        // 4. Stop reactive schedule observation
        scheduleObserverJob.cancelAndJoin()

        // 5. Stop desktop wake loop and clear pending alarms
        reminderScheduler.cancelAndAwait(accountKey)

        // 6. Cancel and await sync jobs
        syncCancelGate.cancelAndAwait(accountKey)

        // 7. Cancel and remove all platform notifications
        reminderCancelGate.cancelAndAwait(accountKey)

        // 8. Drain remote runtime quiescence without blocking on network
        remoteCancelGate?.cancelAndAwait(accountKey)
    }
}
